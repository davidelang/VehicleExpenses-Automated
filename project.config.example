# project.config.example
# Committed template with the same keys as project.config (gitignored).
# Copy to project.config and fill real values. @@TOKEN@@ values are what the
# manage-configs clean filter writes; smudge replaces them from project.config.

sandbox_path=@@SANDBOX_PATH@@
planning_user=@@PLANNING_USER@@
coder_user=@@CODER_USER@@
orchestrator_user=@@ORCHESTRATOR_USER@@
primary_user=@@PRIMARY_USER@@
code_group=@@CODE_GROUP@@
sandbox_group=@@SANDBOX_GROUP@@
shared_group=@@SHARED_GROUP@@
# Binaries may use $HOME/... (expanded by launchers).
grok_bin_default=@@GROK_BIN_DEFAULT@@
gemini_bin_default=@@GEMINI_BIN_DEFAULT@@
# Sandbox subdirs setup-project creates.
sandbox_special_paths=plans,historical-plans,implementation-failure-logs
# Absolute dir holding host clones (not ~/git: agent users have other $HOME).
git_home=@@GIT_HOME@@
antigravity_bin=@@ANTIGRAVITY_BIN@@
# Absolute orchestration root of this project; written by setup_agent.sh / update-rules.sh.
orch_root=@@ORCH_ROOT@@

#!/bin/bash
# set-worktree-perms
# Applies permissions for worktree (@@CODE_GROUP@@ group mainly).
#
# This is infrastructure. After edits, commit in main tree then
# run `sudo ./update-rules.sh` (when agents idle) to propagate copies
# and commits into worktrees. Prevents reverts of this script (and
# append-to-engineering-log) on git operations inside agent worktrees.
#
# Usage:
#   sudo ./set-worktree-perms          # fixes *only the current worktree* (recommended after a build)
#   sudo ./set-worktree-perms --all    # full sweep of all worktrees (orchestration root, post-checkout, etc.)
#   sudo ./set-worktree-perms /path/to/specific/tree
#
# The default "only current" behavior prevents stomping other active worktrees
# that may be compiling or doing unrelated work.

# Ensure any files created during perms application are group-writable
umask 007

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/project.config" ]; then
  . <(sed 's/=/ /; s/^/export /' "$SCRIPT_DIR/project.config" | grep -E '^(code_group|shared_group|docker_group|orchestrator_user|planning_user|coder_user)')
fi

CODE_GROUP=${code_group:-@@CODE_GROUP@@}
SHARED_GROUP=${shared_group:-@@SHARED_GROUP@@}
DOCKER_GROUP=${docker_group:-docker}
ORCHESTRATOR_USER=${orchestrator_user:-@@ORCHESTRATOR_USER@@}
PLANNING_USER=${planning_user:-@@PLANNING_USER@@}
CODER_USER=${coder_user:-@@CODE_GROUP@@r}

echo "Setting worktree perms (@@CODE_GROUP@@ focused) for group $CODE_GROUP..."

# If run via sudo, chown files to the invoking human user + group so the developer has direct access.
# This prevents "no read permission" issues even if group membership not yet active in shell.
SUDO_USER_VAL="${SUDO_USER:-}"
if [ -n "$SUDO_USER_VAL" ] && [ "$SUDO_USER_VAL" != "root" ]; then
  TARGET_OWNER="$SUDO_USER_VAL"
  echo "  (sudo detected: will chown to $TARGET_OWNER:$CODE_GROUP for developer access)"
else
  TARGET_OWNER=""
fi

# Determine which worktree(s) to operate on.
# Default behavior (big improvement): only the *current* worktree unless --all is passed.
# This avoids stomping other active worktrees that may be in the middle of builds.
DO_ALL=false
TARGET_PATH=""

for arg in "$@"; do
  case "$arg" in
    --all|--global)
      DO_ALL=true
      ;;
    *)
      if [ -z "$TARGET_PATH" ]; then
        TARGET_PATH="$arg"
      fi
      ;;
  esac
done

if [ "$DO_ALL" = true ]; then
  mapfile -t WORKTREES < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree / {print $2}')
  echo "  ( --all requested: operating on all worktrees )"
elif [ -n "$TARGET_PATH" ]; then
  WORKTREES=("$TARGET_PATH")
  echo "  (targeting specific path: $TARGET_PATH )"
else
  # Smart default (the key improvement):
  # - If we're in the orchestration root (many worktrees, no "app/" dir), do all.
  # - Otherwise (normal case inside master/ or agent-N/ after a compile), only fix *this* tree.
  # This stops the annoying global chown/chmod that touches trees that are busy compiling.
  NUM_WTS=$(git worktree list --porcelain 2>/dev/null | grep -c '^worktree ' || echo 1)
  if [ "$NUM_WTS" -gt 2 ] && [ ! -d "app" ] && [ ! -f "gradlew" ]; then
    mapfile -t WORKTREES < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree / {print $2}')
    echo "  (orchestration root detected: operating on all worktrees)"
  else
    CURR_TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    WORKTREES=("$CURR_TOPLEVEL")
    echo "  (default: only current worktree - use --all for global sweep)"
  fi
fi

if [ ${#WORKTREES[@]} -eq 0 ]; then
  WORKTREES=(".")
fi

EXECUTABLES=(
  update-rules.sh
  setup-project
  filter-apply-config
  filter-clean-config
  set-worktree-perms
  set-sandbox-perms
  append-to-engineering-log
  todo-append
  todo-close
  run-grok
  run-grok-master
  run-grok-planner
  run-gemini
  run-antigravity
  grok-install.sh
  get-builds-tag.sh
  build_app
  deploy
  setup_agent.sh
  sync_infrastructure.sh
  remove_worktree.sh
  generate_pr.sh
  cleanup_pr.sh
  gradlew
  gradlew.bat
  run-as-dlang
)

for wt in "${WORKTREES[@]}"; do
  echo "  Applying to worktree: $wt"
  if [ -n "$TARGET_OWNER" ]; then
    chown -R "$TARGET_OWNER:$CODE_GROUP" "$wt" 2>/dev/null || true
  else
    chown -R :$CODE_GROUP "$wt" 2>/dev/null || true
  fi

  # Post-chown fixups for critical exceptions (log, TODO, facts, wrapper, build outputs).
  # These must keep special modes after any broad chown.
  # log: chattr +a, 660
  if [ -f "$wt/ENGINEERING_LOG.md" ]; then
    chattr -a "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    chmod 660 "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    chattr +a "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
  fi
  # TODO and facts: 666 for planner/coder access
  # TODO.md and project-facts.md: not world-writable. 664 so group (@@SHARED_GROUP@@) can rw, other r.
  # Additions to TODO are rare (only explicit deferrals). Use todo-append helper when created.
  chmod 664 "$wt/TODO.md" 2>/dev/null || true
  chmod 664 "$wt/project-facts.md" 2>/dev/null || true
  # Wrapper: 755
  if [ -f "$wt/append-to-engineering-log" ]; then
    chmod 755 "$wt/append-to-engineering-log" 2>/dev/null || true
  fi
  # Build outputs: re-apply 2770/660 + setgid so builders (@@CODE_GROUP@@r, dlang) can manage
  for bdir in app/build build .gradle; do
    if [ -d "$wt/$bdir" ]; then
      find "$wt/$bdir" -type d -exec chmod 2770 {} + 2>/dev/null || true
      find "$wt/$bdir" -type f -exec chmod u+rw,g+rw,o-rwx {} + 2>/dev/null || true
    fi
  done

  # Modify r/w permissions only, without altering the execute bit.
  # 664 for regular files: @@CODE_GROUP@@ group (coders + human + orchestrator) get rw,
  # other users (e.g. @@PLANNING_USER@@) get r (read-only). This enforces at Unix level
  # that planners cannot mutate app source even if Grok plan-mode hooks fail.
  find "$wt" -type f -exec chmod u+rw,g+rw,o+r {} + 2>/dev/null || true
  find "$wt" -type d -exec chmod u+rwx,g+rwxs,o+rx {} + 2>/dev/null || true

  # project-facts.md and TODO.md are explicit planner-writable exceptions
  # (stable facts + backlog). Make them world-writable (666) so @@PLANNING_USER@@
  # (which is NOT a member of @@CODE_GROUP@@) can still edit them.
  chmod 666 "$wt/project-facts.md" 2>/dev/null || true
  chmod 666 "$wt/TODO.md" 2>/dev/null || true
  find "$wt" -name .agent-state -type d -exec chmod g+rwX {} + 2>/dev/null || true

  # ENGINEERING_LOG.md must be append-only. Use chattr +a to prevent
  # modification of existing content (even with write perms, non-append
  # writes are blocked at the kernel level). Only root can chattr -a it.
  # Make it group-writable for the wrapper or direct append, but agents
  # are required to use the append-to-engineering-log wrapper for
  # formatting and to follow the "only append new dated entries" rule.
  if [ -f "$wt/ENGINEERING_LOG.md" ]; then
    # Use shared_group for the log so ai-* users (all in @@SHARED_GROUP@@) can append.
    # 660 + chattr +a : group can append, but cannot modify/overwrite existing content.
    chown root:$SHARED_GROUP "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    chmod 660 "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    chattr +a "$wt/ENGINEERING_LOG.md" 2>/dev/null || echo "  (chattr +a failed - run as root)"
  fi

  # Wrapper: make executable by group (@@SHARED_GROUP@@/@@CODE_GROUP@@). No reliance on SUID for
  # shell scripts (kernel ignores setuid on #! scripts). Group write on log + wrapper
  # allows ai users to append via the script.
  if [ -f "$wt/append-to-engineering-log" ]; then
    chown root:$SHARED_GROUP "$wt/append-to-engineering-log" 2>/dev/null || true
    chmod 755 "$wt/append-to-engineering-log" 2>/dev/null || true
  fi

  # Make build_app and deploy setgid to the code group. When executed,
  # they will have the @@CODE_GROUP@@ gid, helping ensure created files
  # (build artifacts, etc.) get correct group ownership. Combined with
  # the umask 007 + sg @@CODE_GROUP@@ inside the scripts, this reduces ownership
  # drift that requires full set-worktree-perms runs.
  for f in build_app deploy; do
    if [ -f "$wt/$f" ]; then
      chmod g+s "$wt/$f" 2>/dev/null || true
    fi
  done

  # Pure Unix enforcement for planning user (no ACLs).
  # @@PLANNING_USER@@ is NOT in @@CODE_GROUP@@. Source dirs are 2775 dlang:@@CODE_GROUP@@ (setgid).
  # Planner (as 'other') gets o+r-x = read source, no write.
  # @@CODE_GROUP@@r etc in @@CODE_GROUP@@ get g+rwxs.
  # We still remove from @@CODE_GROUP@@ group as defense in depth.
  if id "$PLANNING_USER" >/dev/null 2>&1; then
    gpasswd -d "$PLANNING_USER" "$CODE_GROUP" 2>/dev/null || true
    echo "  Group removal for $PLANNING_USER (not in @@CODE_GROUP@@; relies on Unix other=r-x for source read-only)"
  fi

  # Ensure .git tree is writable by ai users (including planner via @@SHARED_GROUP@@) so git can add objects.
  if [ -d "$wt/.git" ]; then
    for aiuser in "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
      # These will be in @@SHARED_GROUP@@; .git 2770 allows
      find "$wt/.git" -type d -exec chmod g+rwxs {} + 2>/dev/null || true
    done
  fi

  # Preserve/ensure execute on critical management/launcher scripts.
  for f in "${EXECUTABLES[@]}"; do
    [ -f "$wt/$f" ] && chmod +x "$wt/$f"
  done

  # Special handling for .gradle (project build cache).
  # Use 660 for files, 2770 for directories (group writable, setgid) so that
  # @@CODE_GROUP@@ group members can access even across different owners (dlang vs ai- users).
  # This is enforced on every perms run, and combined with umask 007 at gradle
  # invocation time, new cache entries created by Gradle will also get 660/2770.
  if [ -d "$wt/.gradle" ]; then
    if [ -n "$TARGET_OWNER" ]; then
      chown -R "$TARGET_OWNER:$CODE_GROUP" "$wt/.gradle" 2>/dev/null || true
    fi
    # Dirs: 2770 (rwxrws--- + setgid)
    find "$wt/.gradle" -type d -exec chmod 2770 {} + 2>/dev/null || true
    # Files: 660 (rw-rw----), preserve execute if any (e.g. 770)
    find "$wt/.gradle" -type f -exec chmod u+rw,g+rw,o-rwx {} + 2>/dev/null || true
  fi

  # Special handling for Android/Gradle build output dirs (app/build, build/, etc.).
  # These contain generated sources (BuildConfig.java, R.java, etc.) that Gradle
  # must be able to overwrite during builds. Use 2770 on dirs + 660 on files
  # under @@CODE_GROUP@@ so any group member (dlang or @@CODE_GROUP@@r etc.) can build.
  # Pruned from planner read-only lockdown above.
  for bdir in app/build build; do
    bpath="$wt/$bdir"
    if [ -d "$bpath" ]; then
      if [ -n "$TARGET_OWNER" ]; then
        chown -R "$TARGET_OWNER:$CODE_GROUP" "$bpath" 2>/dev/null || true
      fi
      find "$bpath" -type d -exec chmod 2770 {} + 2>/dev/null || true
      find "$bpath" -type f -exec chmod u+rw,g+rw,o-rwx {} + 2>/dev/null || true
    fi
  done

  # Final forced state for ENGINEERING_LOG.md and the append wrapper.
  # This must be late so it wins over the broad chown -R at start of loop
  # and any ACL mask lowering from the planner lockdown pass.
  # - log: root:@@SHARED_GROUP@@ 660 + chattr +a + mask rw- + explicit rw- for planner + dlang
  # - wrapper: root:@@SHARED_GROUP@@ 755 (no SUID - kernel ignores it on #! anyway), + r-x for planner, rwx for dlang (for exec + edit)
  if [ -f "$wt/ENGINEERING_LOG.md" ]; then
    # Must remove +a temporarily before any chmod or setfacl (append-only prevents mode/ACL changes).
    chattr -a "$wt/ENGINEERING_LOG.md" 2>/dev/null || true

    chown root:$SHARED_GROUP "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    chmod 660 "$wt/ENGINEERING_LOG.md" 2>/dev/null || true

    # Clear any previous bad ACLs (planner r--, low mask) then re-apply
    setfacl -b "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    setfacl -m "u:$PLANNING_USER:rw-" "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    setfacl -m "u:dlang:rw-" "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    setfacl -m m::rw- "$wt/ENGINEERING_LOG.md" 2>/dev/null || true
    # Ensure the shared group entry itself is not masked out
    setfacl -m "g:$SHARED_GROUP:rw-" "$wt/ENGINEERING_LOG.md" 2>/dev/null || true

    # Restore append-only.
    chattr +a "$wt/ENGINEERING_LOG.md" 2>/dev/null || echo "  (chattr +a failed - must be root)"
  fi
  if [ -f "$wt/append-to-engineering-log" ]; then
    chown root:$SHARED_GROUP "$wt/append-to-engineering-log" 2>/dev/null || true

    # Remove +a if present so chmod won't fail with EPERM.
    chattr -a "$wt/append-to-engineering-log" 2>/dev/null || true

    chmod 755 "$wt/append-to-engineering-log" 2>/dev/null || true
    chmod g+s "$wt/append-to-engineering-log" 2>/dev/null || true  # setgid so egid @@SHARED_GROUP@@ for append even if caller not in group
    chmod -s "$wt/append-to-engineering-log" 2>/dev/null || true  # but keep g+s

    # Clear previous ACLs (e.g. from earlier runs that set rw- without x)
    setfacl -b "$wt/append-to-engineering-log" 2>/dev/null || true
    chmod 755 "$wt/append-to-engineering-log" 2>/dev/null || true
    chmod g+s "$wt/append-to-engineering-log" 2>/dev/null || true

    setfacl -m "u:$PLANNING_USER:r-x" "$wt/append-to-engineering-log" 2>/dev/null || true
    # Maintainer (dlang) needs to run the script (x) + be able to edit it (rw)
    setfacl -m "u:dlang:rwx" "$wt/append-to-engineering-log" 2>/dev/null || true
    setfacl -m m::rwx "$wt/append-to-engineering-log" 2>/dev/null || true
    setfacl -m "g:$SHARED_GROUP:r-x" "$wt/append-to-engineering-log" 2>/dev/null || true
  fi
done

# Ensure orchestrator and the invoking human (if sudo) have access to the @@CODE_GROUP@@ group
usermod -aG $CODE_GROUP $ORCHESTRATOR_USER 2>/dev/null || true
if [ -n "$SUDO_USER_VAL" ] && [ "$SUDO_USER_VAL" != "root" ]; then
  usermod -aG $CODE_GROUP "$SUDO_USER_VAL" 2>/dev/null || true
  usermod -aG $SHARED_GROUP "$SUDO_USER_VAL" 2>/dev/null || true
  echo "  Added $SUDO_USER_VAL to $CODE_GROUP and $SHARED_GROUP (for log access)"
fi

# Grant docker group to @@CODE_GROUP@@r and @@ORCHESTRATOR_USER@@ so they can run docker commands
# (needed for Paddle development: docker build + docker run --privileged -v mounts in paddle-build workflows).
# The human (via sudo) is also added for convenience.
usermod -aG $DOCKER_GROUP $CODER_USER 2>/dev/null || true
usermod -aG $DOCKER_GROUP $ORCHESTRATOR_USER 2>/dev/null || true
if [ -n "$SUDO_USER_VAL" ] && [ "$SUDO_USER_VAL" != "root" ]; then
  usermod -aG $DOCKER_GROUP "$SUDO_USER_VAL" 2>/dev/null || true
  echo "  Added $SUDO_USER_VAL to $DOCKER_GROUP (for docker access)"
fi

# Compute the main repo root (works from root or inside worktree)
REPO_ROOT="$(cd "$SCRIPT_DIR" && git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Use wildcard form so it trusts the root and any subdirectories/worktrees/sandbox
# without having to list each one individually.
SAFE_WILDCARD="$REPO_ROOT/*"

# Configure git safe.directory so that different users (dlang vs ai-*) can operate on the repos
# without "detected dubious ownership" errors in modern git (>=2.35.2).
if [ -n "$TARGET_OWNER" ]; then
  sudo -u "$TARGET_OWNER" git config --global --add safe.directory "$SAFE_WILDCARD" 2>/dev/null || true
  echo "  Added safe.directory '$SAFE_WILDCARD' for $TARGET_OWNER"
elif [ "$EUID" -eq 0 ] && [ -n "$SUDO_USER_VAL" ]; then
  sudo -u "$SUDO_USER_VAL" git config --global --add safe.directory "$SAFE_WILDCARD" 2>/dev/null || true
fi

# Also configure for the ai-* users so they can git on dlang-owned repos
for aiuser in "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
  if [ -n "$aiuser" ] && id "$aiuser" >/dev/null 2>&1; then
    sudo -u "$aiuser" git config --global --add safe.directory "$SAFE_WILDCARD" 2>/dev/null || true
    echo "  Added safe.directory '$SAFE_WILDCARD' for $aiuser"
  fi
done

echo "Worktree perms applied."

if [ "$DO_ALL" != true ]; then
  echo ""
  echo "Note: Only touched the current worktree (or the one you specified)."
  echo "Other branches were left alone. Run with --all if you really need a full sweep."
fi

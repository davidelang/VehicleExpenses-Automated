#!/bin/bash
# set-worktree-perms
# Applies permissions for worktree (@@CODE_GROUP@@ group mainly).

# Ensure any files created during perms application are group-writable
umask 007

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/project.config" ]; then
  . <(sed 's/=/ /; s/^/export /' "$SCRIPT_DIR/project.config" | grep -E '^(code_group|orchestrator_user|planning_user|coder_user)')
fi

CODE_GROUP=${code_group:-@@CODE_GROUP@@}
ORCHESTRATOR_USER=${orchestrator_user:-@@ORCHESTRATOR_USER@@}
PLANNING_USER=${planning_user:-@@PLANNING_USER@@}
CODER_USER=${coder_user:-@@CODE_GROUP@@r}

echo "Setting worktree perms (@@CODE_GROUP@@ focused) for group $CODE_GROUP..."

# If run via sudo, chown files to the invoking human user + group so the developer has direct access.
# This prevents "no read permission" issues even if group membership not yet active in shell.
if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
  TARGET_OWNER="$SUDO_USER"
  echo "  (sudo detected: will chown to $TARGET_OWNER:$CODE_GROUP for developer access)"
else
  TARGET_OWNER=""
fi

# Discover worktrees if in orchestration layer (or always use list for completeness)
mapfile -t WORKTREES < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree / {print $2}')
if [ ${#WORKTREES[@]} -eq 0 ]; then
  WORKTREES=(".")
fi

EXECUTABLES=(
  update-rules.sh
  setup-project
  filter-apply-config
  filter-clean-config
  set-worktree-perms
  set-sandbox-perms
  run-grok
  run-grok-master
  run-grok-planner
  run-gemini
  run-antigravity
  grok-install.sh
  get-builds-tag.sh
  build_app
  deploy
  setup_agent.sh
  sync_infrastructure.sh
  remove_worktree.sh
  generate_pr.sh
  cleanup_pr.sh
  gradlew
  gradlew.bat
)

for wt in "${WORKTREES[@]}"; do
  echo "  Applying to worktree: $wt"
  if [ -n "$TARGET_OWNER" ]; then
    chown -R "$TARGET_OWNER:$CODE_GROUP" "$wt" 2>/dev/null || true
  else
    chown -R :$CODE_GROUP "$wt" 2>/dev/null || true
  fi

  # Modify r/w permissions only, without altering the execute bit.
  find "$wt" -type f -exec chmod u+rw,g+r,o-rwx {} + 2>/dev/null || true
  find "$wt" -type d -exec chmod u+rwx,g+rwxs,o+rx {} + 2>/dev/null || true

  # project-facts.md and TODO.md are tracked but are explicit planner exceptions (stable facts + backlog).
  # Ensure the @@CODE_GROUP@@ group (@@PLANNING_USER@@ / @@CODE_GROUP@@r) can write them.
  chmod g+rw "$wt/project-facts.md" 2>/dev/null || true
  chmod g+rw "$wt/TODO.md" 2>/dev/null || true
  find "$wt" -name .agent-state -type d -exec chmod g+rwX {} + 2>/dev/null || true

  # Preserve/ensure execute on critical management/launcher scripts.
  for f in "${EXECUTABLES[@]}"; do
    [ -f "$wt/$f" ] && chmod +x "$wt/$f"
  done

  # Special handling for .gradle (project build cache).
  # Use 660 for files, 2770 for directories (group writable, setgid) so that
  # @@CODE_GROUP@@ group members can access even across different owners (dlang vs ai- users).
  # This is enforced on every perms run, and combined with umask 007 at gradle
  # invocation time, new cache entries created by Gradle will also get 660/2770.
  if [ -d "$wt/.gradle" ]; then
    if [ -n "$TARGET_OWNER" ]; then
      chown -R "$TARGET_OWNER:$CODE_GROUP" "$wt/.gradle" 2>/dev/null || true
    fi
    # Dirs: 2770 (rwxrws--- + setgid)
    find "$wt/.gradle" -type d -exec chmod 2770 {} + 2>/dev/null || true
    # Files: 660 (rw-rw----), preserve execute if any (e.g. 770)
    find "$wt/.gradle" -type f -exec chmod u+rw,g+rw,o-rwx {} + 2>/dev/null || true
  fi
done

# Ensure orchestrator and the invoking human (if sudo) have access to the @@CODE_GROUP@@ group
usermod -aG $CODE_GROUP $ORCHESTRATOR_USER 2>/dev/null || true
if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
  usermod -aG $CODE_GROUP "$SUDO_USER" 2>/dev/null || true
  echo "  Added $SUDO_USER to $CODE_GROUP (group membership will be active after new login/shell)"
fi

# Compute the main repo root (works from root or inside worktree)
REPO_ROOT="$(cd "$SCRIPT_DIR" && git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Use wildcard form so it trusts the root and any subdirectories/worktrees/sandbox
# without having to list each one individually.
SAFE_WILDCARD="$REPO_ROOT/*"

# Configure git safe.directory so that different users (dlang vs ai-*) can operate on the repos
# without "detected dubious ownership" errors in modern git (>=2.35.2).
if [ -n "$TARGET_OWNER" ]; then
  sudo -u "$TARGET_OWNER" git config --global --add safe.directory "$SAFE_WILDCARD" 2>/dev/null || true
  echo "  Added safe.directory '$SAFE_WILDCARD' for $TARGET_OWNER"
elif [ "$EUID" -eq 0 ] && [ -n "$SUDO_USER" ]; then
  sudo -u "$SUDO_USER" git config --global --add safe.directory "$SAFE_WILDCARD" 2>/dev/null || true
fi

# Also configure for the ai-* users so they can git on dlang-owned repos
for aiuser in "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
  if [ -n "$aiuser" ] && id "$aiuser" >/dev/null 2>&1; then
    sudo -u "$aiuser" git config --global --add safe.directory "$SAFE_WILDCARD" 2>/dev/null || true
    echo "  Added safe.directory '$SAFE_WILDCARD' for $aiuser"
  fi
done

echo "Worktree perms applied."

#!/bin/bash
# run-antigravity
# Launch Antigravity CLI in the current agent worktree as the ai-orchestrator user.
# Sandbox is provided via the ./dev-ai-interaction symlink (created by setup_agent or enable-full-orchestration.sh).
# Full orchestration layout expected.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX_DIR="$SCRIPT_DIR/dev-ai-interaction"

# Load permission config if present (populated by smudge filter / setup)
if [ -f project.config ]; then
  . <(sed 's/=/ /; s/^/export /' project.config | grep -E '^(orchestrator_user|antigravity_bin)')
fi
ORCHESTRATOR_USER=${orchestrator_user:-ai-orchestrator}

# Ensure all files created during this session are group-writable (multi-user env)
umask 002

ANTIGRAVITY_BIN="${ANTIGRAVITY_BIN:-${antigravity_bin:-$HOME/git/antigravity/agy}}"

echo "Launching Antigravity agent in $(pwd)..."
echo "Antigravity binary: $ANTIGRAVITY_BIN"
echo "Sandbox path: $SANDBOX_DIR"
echo "Running as: $ORCHESTRATOR_USER (via sudo -u)"

# Tip similar to other launchers
echo "Tip: For easier multi-line plans and prompts, focus the input and press Ctrl+M (or type /multiline or /ml) to enable multiline input mode (Enter inserts newline; Shift+Enter or Alt+Enter sends)."

# Support -- to pass raw params to antigravity.
EXTRA_ARGS=()
FOUND_DD=0
for arg in "$@"; do
  if [ "$FOUND_DD" -eq 1 ]; then
    EXTRA_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    FOUND_DD=1
  fi
done

exec sudo -u "$ORCHESTRATOR_USER" "$ANTIGRAVITY_BIN" \
    -i "You are starting a fresh session in this multi-agent project. As your very first action, read the file new_agent_prompt in the current working directory (use your Read tool if needed) and follow its instructions to the letter. This includes immediately reading AGENT_CONTEXT.md and your CLI thin overlay (GROK.md or GEMINI.md), providing the required brief Mandate Acknowledgment report (overrides, barrier, verification, geography with Role+Branch, plans directory rule, etc.), and then waiting. Do not read TODO.md, search for other files, or begin any other task until the user provides a specific directive after your report. Your only mission right now is to introduce yourself via the report and wait." \
    --add-dir "$SANDBOX_DIR" \
    "${EXTRA_ARGS[@]}"

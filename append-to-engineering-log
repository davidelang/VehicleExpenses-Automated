#!/bin/bash
# append-to-engineering-log
# Controlled wrapper for appending ONLY to ENGINEERING_LOG.md.
# Agents MUST use this (never direct edits or >>).
# chattr +a on the log prevents modification of existing lines even if someone
# has write permission. Git reset/checkout on the log will fail for non-root.
#
# Owned by dlang:ai-shared 660 + chattr +a. The script should be setgid ai-shared
# (chmod g+s) so that when executed by ai-* users, the process gets the group
# for the append.
# Direct append works; no sudo/password prompts in normal operation.
#
# This file is infrastructure. After edits, commit in main tree then
# run `sudo ./update-rules.sh` (agents idle) to sync + commit into worktrees.
# This keeps versions consistent and prevents reverts in agent worktrees.

set -euo pipefail

# Locate the worktree root reliably.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  ROOT=$(git rev-parse --show-toplevel)
else
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

LOGFILE="$ROOT/ENGINEERING_LOG.md"
if [ ! -f "$LOGFILE" ]; then
  echo "ERROR: $LOGFILE not found" >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  echo "Usage: $(basename "$0") '## YYYY-MM-DD - Title\n\n- bullet ...'" >&2
  echo "   or: $(basename "$0") @file-with-entry.txt" >&2
  exit 1
fi

if [[ "$1" == @* ]]; then
  f="${1#@}"
  if [ -f "$f" ]; then
    ENTRY=$(cat "$f")
  else
    echo "ERROR: $f not found" >&2
    exit 1
  fi
else
  ENTRY="$*"
fi

# Enforce the required dated header format.
if [[ ! $ENTRY =~ ^##\ [0-9]{4}- ]]; then
  echo "ERROR: Entry must start with '## YYYY-MM-DD - ...'" >&2
  exit 1
fi

# Perform the append directly. Permissions must allow direct write:
# the log is chattr +a, 660 root:ai-shared + ACLs (dlang:rw-, ai-planner:rw-,
# ai-coder:rw-, ai-orchestrator:rw-, mask:rw-, group:rw-). This is set up
# by fix-engineering-log-perms / set-worktree-perms so the script never needs
# to ask for passwords or use sudo.
do_append() {
  if printf '\n%s\n' "$ENTRY" >> "$LOGFILE" 2>/dev/null; then
    return 0
  fi

  echo "ERROR: cannot append to $LOGFILE (permissions/ACLs/chattr not set for $(id -un); run fix-engineering-log-perms as root)" >&2
  exit 1
}

do_append "$@"

echo "Appended entry to ENGINEERING_LOG.md"
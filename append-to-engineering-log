#!/bin/bash
# append-to-engineering-log
# Controlled wrapper for appending to ENGINEERING_LOG.md .
# Agents MUST use ONLY this to add entries. Direct edits or >> are discouraged
# and may be blocked by filesystem attributes (chattr +a).

set -euo pipefail

# Find the worktree root reliably
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  ROOT=$(git rev-parse --show-toplevel)
else
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

LOGFILE="$ROOT/ENGINEERING_LOG.md"
if [ ! -f "$LOGFILE" ]; then
  echo "ERROR: $LOGFILE not found" >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  echo "Usage: $(basename "$0") '## YYYY-MM-DD - Title\n\n- bullet'" >&2
  echo "   or: $(basename "$0") @file-with-entry.txt" >&2
  exit 1
fi

if [[ "$1" == @* ]]; then
  f="${1#@}"
  if [ -f "$f" ]; then
    ENTRY=$(cat "$f")
  else
    echo "ERROR: $f not found" >&2
    exit 1
  fi
else
  ENTRY="$*"
fi

# Enforce basic format for the log
if [[ ! $ENTRY =~ ^##\ [0-9]{4}- ]]; then
  echo "ERROR: Entry must start with '## YYYY-MM-DD - ...'" >&2
  exit 1
fi

# Safe append (chattr +a will prevent non-append operations)
printf '\n%s\n' "$ENTRY" >> "$LOGFILE"

echo "Appended entry to ENGINEERING_LOG.md"

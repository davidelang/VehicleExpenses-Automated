#!/bin/bash
# sync-debug-keystores — force every project role user onto the same debug signing key
#
# Problem: each OS user (ai-coder, ai-orchestrator, …) auto-generates a unique
# ~/.android/debug.keystore. An install with that key poisons a device; later
# installs signed with the project/shared (dlang) key fail with
# INSTALL_FAILED_UPDATE_INCOMPATIBLE.
#
# Fix: copy the project .android-shared (or primary user's) debug.keystore into
# each role home. build_app/deploy also set ANDROID_USER_HOME to .android-shared.
#
# Usage (from any worktree or orchestration root):
#   ./sync-debug-keystores
#   sudo ./sync-debug-keystores   # for chown into other users' homes
#
# Safe: only overwrites debug.keystore; backs up divergent keys as *.foreign-backup*

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Worktree: parent often has .android-shared
ORCH_ROOT="$SCRIPT_DIR"
if [ -d "$SCRIPT_DIR/../.android-shared" ] && [ ! -f "$SCRIPT_DIR/.android-shared/debug.keystore" ]; then
  ORCH_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [ -d "$SCRIPT_DIR/../.gradle-shared" ]; then
  ORCH_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

if [ -f "$SCRIPT_DIR/project.config" ]; then
  # shellcheck disable=SC1091
  . <(sed 's/=/ /; s/^/export /' "$SCRIPT_DIR/project.config" | grep -E '^(primary_user|coder_user|orchestrator_user|planning_user|code_group|shared_group)' || true)
fi
PRIMARY_USER=${primary_user:-dlang}
CODER_USER=${coder_user:-ai-coder}
ORCHESTRATOR_USER=${orchestrator_user:-ai-orchestrator}
PLANNING_USER=${planning_user:-ai-planner}
CODE_GROUP=${code_group:-ai-code}
SHARED_GROUP=${shared_group:-ai-shared}

SHARED_DIR="${ORCH_ROOT}/.android-shared"
SHARED_KS="${SHARED_DIR}/debug.keystore"
PRIMARY_KS="/home/${PRIMARY_USER}/.android/debug.keystore"

mkdir -p "$SHARED_DIR/cache"
if [ ! -f "$SHARED_KS" ]; then
  if [ -f "$PRIMARY_KS" ]; then
    echo "Seeding $SHARED_KS from $PRIMARY_KS"
    cp "$PRIMARY_KS" "$SHARED_KS"
    cp "${PRIMARY_KS}.lock" "${SHARED_KS}.lock" 2>/dev/null || : > "${SHARED_KS}.lock"
  else
    echo "ERROR: no shared keystore and no $PRIMARY_KS to seed from" >&2
    exit 1
  fi
fi
chgrp "$CODE_GROUP" "$SHARED_KS" 2>/dev/null || true
chmod 660 "$SHARED_KS" 2>/dev/null || true

fingerprint() {
  keytool -list -v -keystore "$1" -storepass android 2>/dev/null | awk '/SHA1:/{print $2; exit}'
}

GOOD=$(fingerprint "$SHARED_KS")
if [ -z "$GOOD" ]; then
  echo "ERROR: cannot read fingerprint from $SHARED_KS" >&2
  exit 1
fi
echo "Canonical debug key SHA1=$GOOD"
echo "  source: $SHARED_KS"

sync_user() {
  local user="$1"
  local home
  home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6)
  if [ -z "$home" ] || [ ! -d "$home" ]; then
    echo "  skip $user (no home)"
    return 0
  fi
  if ! mkdir -p "$home/.android" 2>/dev/null; then
    echo "  skip $user (cannot create $home/.android — re-run as root/primary)"
    return 0
  fi
  local dest="$home/.android/debug.keystore"
  if [ -f "$dest" ]; then
    local cur
    cur=$(fingerprint "$dest")
    if [ "$cur" = "$GOOD" ]; then
      echo "  OK $user (already $GOOD)"
      chmod 660 "$dest" 2>/dev/null || true
      return 0
    fi
    local bak="${dest}.foreign-backup-$(date +%Y%m%d%H%M%S)"
    echo "  REPLACE $user (was ${cur:-unknown}) → backup $bak"
    cp -a "$dest" "$bak" 2>/dev/null || cp "$dest" "$bak"
  else
    echo "  INSTALL $user"
  fi
  rm -f "$dest" "${dest}.lock"
  cp "$SHARED_KS" "$dest"
  : > "${dest}.lock"
  if chown "$user:$CODE_GROUP" "$dest" "${dest}.lock" 2>/dev/null; then
    :
  else
    chgrp "$CODE_GROUP" "$dest" "${dest}.lock" 2>/dev/null || true
  fi
  chmod 660 "$dest" "${dest}.lock" 2>/dev/null || true
  chmod 2770 "$home/.android" 2>/dev/null || true
  local after
  after=$(fingerprint "$dest")
  if [ "$after" = "$GOOD" ]; then
    echo "    now $user SHA1=$after OK"
  else
    echo "    ERROR $user SHA1=${after:-none} (expected $GOOD)" >&2
    return 1
  fi
}

FAIL=0
for u in "$PRIMARY_USER" "$CODER_USER" "$ORCHESTRATOR_USER" "$PLANNING_USER"; do
  sync_user "$u" || FAIL=1
done

# Worktree-local .android-shared copies (agent-N) should match too
for d in "$ORCH_ROOT"/.android-shared "$SCRIPT_DIR"/.android-shared; do
  [ -d "$d" ] || continue
  if [ -f "$d/debug.keystore" ]; then
    cur=$(fingerprint "$d/debug.keystore")
    if [ "$cur" != "$GOOD" ]; then
      echo "  REPLACE worktree $d/debug.keystore (was $cur)"
      cp "$SHARED_KS" "$d/debug.keystore"
    fi
  else
    cp "$SHARED_KS" "$d/debug.keystore"
    echo "  INSTALL $d/debug.keystore"
  fi
  chmod 660 "$d/debug.keystore" 2>/dev/null || true
done

echo
if [ "$FAIL" -ne 0 ]; then
  echo "Done with errors (re-run with sudo for homes you cannot write)."
  exit 1
fi
echo "Done. All reachable role keystores match canonical SHA1=$GOOD"
echo "Note: devices already installed with a foreign key still need uninstall once:"
echo "  adb -s <serial> uninstall com.davidlang.vehicleexpensesautomated"
echo "  then human: ./deploy"
exit 0

#!/usr/bin/env bash
# libpin-sandbox — optional Landlock + bubblewrap for pin tooling
#
# Modes (write surfaces for mutation; reads stay unrestricted under Landlock):
#   third_party  → third_party/
#   lib          → third_party/<lib>/
#   src          → third_party/<lib>/src/
#   artifact     → third_party/<lib>/artifact/
#
# Order when both available:
#   bwrap (outer, if not already sandboxed) → landlock (inner, stackable) → command
#
# Usage:
#   libpin-sandbox --mode lib|src|artifact --lib NAME -- command…
#   libpin-sandbox --mode third_party -- command…
#
# Env:
#   LIBPIN_NO_BWRAP=1 / LIBPIN_NO_LANDLOCK=1
#   LIBPIN_SANDBOX=<mode>   already in bwrap — do not nest bwrap
#   GIT_HOME + --lib NAME → auto-allow only $GIT_HOME/<lib>/.git (rw/upgrade linked worktree metadata;
#     ro uses a shared clone and does not write it);
#     libpin.toml host_repo overrides <lib> (relative = under GIT_HOME, "/" = absolute)
#   LIBPIN_BWRAP_DEBUG=1 / LIBPIN_LANDLOCK_DEBUG=1
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODE=""
LIB=""

usage() {
  sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --mode) MODE="$2"; shift 2 ;;
    --lib) LIB="$2"; shift 2 ;;
    --) shift; break ;;
    -*)
      echo "libpin-sandbox: unknown option: $1" >&2
      exit 2
      ;;
    *) break ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "libpin-sandbox: missing command" >&2
  exit 2
fi
if [[ -z "$MODE" ]]; then
  echo "libpin-sandbox: --mode required" >&2
  exit 2
fi

# Narrow host allow: only this lib's object store / worktree registry (not whole GIT_HOME).
# Top-level host_repo from third_party/<lib>/libpin.toml; empty when absent. rc != 0 = unreadable.
host_repo_of_lib() {
  local pin="$HERE/$1/libpin.toml"
  [[ -f "$pin" ]] || return 0
  python3 - "$pin" <<'PY2'
import sys, tomllib
from pathlib import Path
v = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("host_repo")
if v is not None:
    print(v)
PY2
}

resolve_host_git() {
  local lib="$1" hr="$2" gh p
  gh="${GIT_HOME:-}"
  if [[ "$hr" == /* ]]; then
    p="$hr"
  else
    [[ -n "$lib" && -n "$gh" ]] || return 1
    p="$gh/${hr:-$lib}"
  fi
  local gerr
  if [[ -e "$p/.git" ]] && ! gerr="$(git -C "$p" rev-parse --git-dir 2>&1)"; then
    echo "libpin-sandbox: git rejects $p: $gerr" >&2
    return 1
  fi
  if [[ -d "$p/.git" ]]; then
    if command -v realpath >/dev/null 2>&1; then realpath "$p/.git"; else readlink -f "$p/.git"; fi
    return 0
  fi
  if [[ -f "$p/.git" ]]; then
    # gitfile: gitdir: /path/to/.git
    local gd
    gd="$(sed -n 's/^gitdir:[[:space:]]*//p' "$p/.git" | head -1)"
    [[ -n "$gd" && -d "$gd" ]] || return 1
    # Prefer common .git root (strip /worktrees/…)
    if [[ "$gd" == */worktrees/* ]]; then
      gd="${gd%%/worktrees/*}"
    fi
    if command -v realpath >/dev/null 2>&1; then realpath "$gd"; else readlink -f "$gd"; fi
    return 0
  fi
  return 1
}

HOST_GIT=""
if [[ -n "$LIB" ]]; then
  if ! HOST_REPO="$(host_repo_of_lib "$LIB")"; then
    echo "libpin-sandbox: cannot read host_repo from $HERE/$LIB/libpin.toml" >&2
    exit 2
  fi
  if [[ -n "$HOST_REPO" ]]; then
    if ! HOST_GIT="$(resolve_host_git "$LIB" "$HOST_REPO")"; then
      echo "libpin-sandbox: host_repo '$HOST_REPO' for $LIB does not resolve to a git dir (GIT_HOME=${GIT_HOME:-<unset>})" >&2
      exit 2
    fi
  else
    HOST_GIT="$(resolve_host_git "$LIB" "" || true)"
  fi
fi
if [[ -n "$HOST_GIT" ]]; then
  export LIBPIN_HOST_GIT="$HOST_GIT"
fi

# Build final command: optionally wrap with landlock first (runs inside bwrap if used)
CMD=("$@")
if [[ "${LIBPIN_NO_LANDLOCK:-0}" != "1" && -x "$HERE/libpin-landlock" ]]; then
  LL=( "$HERE/libpin-landlock" --mode "$MODE" --tp-root "$HERE" )
  [[ -n "$LIB" ]] && LL+=( --lib "$LIB" )
  [[ -n "$HOST_GIT" ]] && LL+=( --path "$HOST_GIT" )
  LL+=( -- )
  CMD=( "${LL[@]}" "${CMD[@]}" )
fi

# Outer bwrap (single-level only)
if [[ "${LIBPIN_NO_BWRAP:-0}" != "1" && -z "${LIBPIN_SANDBOX:-}" && -x "$HERE/libpin-bwrap" ]]; then
  BW=( "$HERE/libpin-bwrap" --mode "$MODE" )
  [[ -n "$LIB" ]] && BW+=( --lib "$LIB" )
  BW+=( -- )
  # libpin-bwrap sets LIBPIN_SANDBOX; landlock still applies inside
  exec "${BW[@]}" "${CMD[@]}"
fi

exec "${CMD[@]}"

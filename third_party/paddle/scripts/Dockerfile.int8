# VE Paddle-Lite build image: Ubuntu 20.04 + NDK r20b + JDK8 + patchelf.
# Source tree is NOT baked in — mount pin src at runtime (libpin).
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    python3 \
    python3-dev \
    python3-pip \
    wget \
    unzip \
    libncurses5 \
    libssl-dev \
    pkg-config \
    curl \
    openjdk-8-jdk \
    patchelf \
    && rm -rf /var/lib/apt/lists/*

# NDK r20b (matches historical VE paddle-build)
RUN wget -q https://dl.google.com/android/repository/android-ndk-r20b-linux-x86_64.zip && \
    unzip -q android-ndk-r20b-linux-x86_64.zip -d /opt && \
    rm android-ndk-r20b-linux-x86_64.zip && \
    sed -i 's/list(APPEND ANDROID_LINKER_FLAGS "-static-libstdc++")/# list(APPEND ANDROID_LINKER_FLAGS "-static-libstdc++")/g' \
      /opt/android-ndk-r20b/build/cmake/android.toolchain.cmake

ENV NDK_ROOT=/opt/android-ndk-r20b
ENV ANDROID_NDK=/opt/android-ndk-r20b
ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64

WORKDIR /workspace
# third-party tarball expected at runtime under pin src or downloaded once:
# see run-android-slim.sh

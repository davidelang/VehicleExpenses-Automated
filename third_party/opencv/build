#!/usr/bin/env bash
# OpenCV pin build — sources in ./src (materialized by fetch-deps).
# Writes under src/build/<abi> (CMake binary dir) and src/bin/<abi>/libopencv_java4.so
# get-artifacts copies to artifact/jni/<abi>/
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
exec bash "$HERE/scripts/build-android-16k.sh"

#!/bin/bash
# run-grok — bare primary-user (dlang) session: process-break / fewer multi-agent guardrails.
# Human may explicitly authorize violating normal project process. Not the default agent path.
# For multi-agent roles use: run-grok-orchestrator, run-grok-master, run-grok-planner, run-grok-coder.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX_DIR="$SCRIPT_DIR/@@SANDBOX_PATH@@"
if [ -f project.config ]; then
  . <(sed 's/=/ /; s/^/export /' project.config | grep -E '^(primary_user|GROK_BIN)')
fi
PRIMARY_USER=${primary_user:-dlang}
GROK_BIN="${GROK_BIN:-@@GROK_BIN_DEFAULT@@}"

umask 002

echo "Launching bare Grok as primary user ($PRIMARY_USER) in $(pwd)..."
echo "Grok binary: $GROK_BIN"
echo "Sandbox path: $SANDBOX_DIR"
echo "Mode: process-break allowed — user may authorize violating multi-agent rules."
echo "Tip: Ctrl+M or /multiline for multi-line input."

EXTRA_ARGS=()
FOUND_DD=0
for arg in "$@"; do
  if [ "$FOUND_DD" -eq 1 ]; then
    EXTRA_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    FOUND_DD=1
  fi
done

# Run as current user if already primary; else sudo -u primary.
# umask 002 must apply in the *running* process (sudo does not keep parent umask).
PROMPT="You are running as the primary developer ($PRIMARY_USER) in a bare Grok session. Normal multi-agent process is optional. You may read AGENTS.md / AGENT_MANDATES.md if useful. The human may explicitly authorize violating those rules in this session. Confirm cwd once with pwd; never prefix helpers with cd … &&. Await the user's directive."
if [ "$(id -un)" = "$PRIMARY_USER" ]; then
  umask 002
  exec "$GROK_BIN" \
    "$PROMPT" \
    --no-alt-screen \
    "${EXTRA_ARGS[@]}"
else
  exec sudo -u "$PRIMARY_USER" -- bash -c 'umask 002; exec "$@"' bash \
    "$GROK_BIN" \
    "$PROMPT" \
    --no-alt-screen \
    "${EXTRA_ARGS[@]}"
fi

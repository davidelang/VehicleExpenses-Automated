#!/bin/bash
# run-grok — bare primary-user (dlang) session: process-break / fewer multi-agent guardrails.
# Prompt pack: new_agent_prompt + role-primary.md

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX_DIR="$SCRIPT_DIR/@@SANDBOX_PATH@@"
COMPOSE="$SCRIPT_DIR/.grok/prompts/compose-session-prompt.sh"
if [ -f project.config ]; then
  . <(sed 's/=/ /; s/^/export /' project.config | grep -E '^(primary_user|GROK_BIN)')
fi
PRIMARY_USER=${primary_user:-dlang}
GROK_BIN="${GROK_BIN:-@@GROK_BIN_DEFAULT@@}"

umask 002

ANDROID_SHARED=""
if [ -d "$SCRIPT_DIR/.android-shared" ]; then
  ANDROID_SHARED="$SCRIPT_DIR/.android-shared"
elif [ -d "$SCRIPT_DIR/../.android-shared" ]; then
  ANDROID_SHARED="$(cd "$SCRIPT_DIR/.." && pwd)/.android-shared"
fi

echo "Launching bare Grok as primary user ($PRIMARY_USER) in $(pwd)..."
echo "Grok binary: $GROK_BIN"
echo "Sandbox path: $SANDBOX_DIR"
echo "Prompt pack: new_agent_prompt + .grok/prompts/role-primary.md"
echo "Mode: process-break allowed — user may authorize violating multi-agent rules."
[ -n "$ANDROID_SHARED" ] && echo "ANDROID_USER_HOME: $ANDROID_SHARED"
echo "Tip: Ctrl+M or /multiline for multi-line input."

EXTRA_ARGS=()
FOUND_DD=0
for arg in "$@"; do
  if [ "$FOUND_DD" -eq 1 ]; then
    EXTRA_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    FOUND_DD=1
  fi
done

export GROK_PROMPT_ROOT="$SCRIPT_DIR"
PROMPT="$("$COMPOSE" new_agent_prompt .grok/prompts/role-primary.md)"

if [ "$(id -un)" = "$PRIMARY_USER" ]; then
  umask 002
  [ -n "$ANDROID_SHARED" ] && export ANDROID_USER_HOME="$ANDROID_SHARED"
  exec "$GROK_BIN" \
    "$PROMPT" \
    --no-alt-screen \
    "${EXTRA_ARGS[@]}"
else
  exec sudo -u "$PRIMARY_USER" -- env ${ANDROID_SHARED:+ANDROID_USER_HOME="$ANDROID_SHARED"} GROK_PROMPT_ROOT="$SCRIPT_DIR" bash -c 'umask 002; exec "$@"' bash \
    "$GROK_BIN" \
    "$PROMPT" \
    --no-alt-screen \
    "${EXTRA_ARGS[@]}"
fi

#!/bin/bash
# run-grok-orchestrator — multi-agent brain/infra on orchestration branch (ai-orchestrator).
# Session prompt = compose of new_agent_prompt + role-orchestrator.md.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANDBOX_DIR="$SCRIPT_DIR/dev-ai-interaction"
COMPOSE="$SCRIPT_DIR/.grok/prompts/compose-session-prompt.sh"
if [ -f project.config ]; then
  . <(sed 's/=/ /; s/^/export /' project.config | grep -E '^(orchestrator_user|GROK_BIN)')
fi
ORCHESTRATOR_USER=${orchestrator_user:-ai-orchestrator}
GROK_BIN="${GROK_BIN:-$HOME/git/grok/bin/grok}"

umask 002

ANDROID_SHARED=""
if [ -d "$SCRIPT_DIR/.android-shared" ]; then
  ANDROID_SHARED="$SCRIPT_DIR/.android-shared"
elif [ -d "$SCRIPT_DIR/../.android-shared" ]; then
  ANDROID_SHARED="$(cd "$SCRIPT_DIR/.." && pwd)/.android-shared"
fi

echo "Launching Orchestrator Grok in $(pwd)..."
echo "Grok binary: $GROK_BIN"
echo "Sandbox path: $SANDBOX_DIR"
echo "Running as: $ORCHESTRATOR_USER (via sudo -u)"
echo "Prompt pack: new_agent_prompt + .grok/prompts/role-orchestrator.md"
[ -n "$ANDROID_SHARED" ] && echo "ANDROID_USER_HOME: $ANDROID_SHARED"
echo "Tip: Ctrl+M or /multiline for multi-line input."

TODO_GATE_FLAGS=""
if [ "${GROK_TODO_GATE:-0}" = "1" ] || [ "${GROK_TODO_GATE:-0}" = "true" ]; then
  TODO_GATE_FLAGS="--todo-gate"
fi

EXTRA_ARGS=()
FOUND_DD=0
for arg in "$@"; do
  if [ "$FOUND_DD" -eq 1 ]; then
    EXTRA_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    FOUND_DD=1
  fi
done

export GROK_PROMPT_ROOT="$SCRIPT_DIR"
PROMPT="$("$COMPOSE" new_agent_prompt .grok/prompts/role-orchestrator.md)"

exec sudo -u "$ORCHESTRATOR_USER" -- env ${ANDROID_SHARED:+ANDROID_USER_HOME="$ANDROID_SHARED"} GROK_PROMPT_ROOT="$SCRIPT_DIR" bash -c 'umask 002; exec "$@"' bash \
    "$GROK_BIN" \
    "$PROMPT" \
    $TODO_GATE_FLAGS \
    --no-alt-screen \
    "${EXTRA_ARGS[@]}"

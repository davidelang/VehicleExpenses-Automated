#!/bin/bash

# Enhanced build_app: Explicit Integrity & Detailed Summaries
# THE ONLY WAY TO BUILD OR COMPILE.
# Usage: ./build_app ["Commit Message" | "@msg_file.txt"] [file1 file2 ...] [-- gradle-flag ...]
#
# NEVER run gradlew, gradlew.bat, or direct gradle commands (forbidden; this is the enforced gateway).
# It handles: git commit, tag update, forensic checks, local .gradle repair, umask/sg enforcement.
# Pass gradle options after -- (e.g. build_app "msg" file.kt -- --info --stacktrace).
# If agents pass --info or --stacktrace, they go here — no raw gradlew ever needed.

# Load primary_user from project.config for portable primary developer identity (no hardcoded names).
PRIMARY_USER=$(sed -n 's/^primary_user=//p' project.config 2>/dev/null | tr -d '\r' | head -1)
PRIMARY_USER=${PRIMARY_USER:-dlang}

# Re-exec as PRIMARY_USER (not root) if we started as root. This ensures we use
# the primary developer's debug keystore (~/.android/debug.keystore) for consistent APK
# signatures across builds. Running as root uses /root's keystore,
# which produces a different certificate and triggers
# INSTALL_FAILED_UPDATE_INCOMPATIBLE on deploy.
if [ "$EUID" -eq 0 ]; then
  echo "Re-executing as $PRIMARY_USER (not root)..."
  exec sudo -E -u "$PRIMARY_USER" "$0" "$@"
fi

# Source/docs: prefer 664/2775 → umask 002. Build outputs tightened after gradle.
umask 002

# ai-shared + ai-code required (agent caches are ai-coder:ai-code). Do not sg one group.
MISSING=""
for grp in ai-shared ai-code; do
  if ! id -nG | grep -qw "$grp"; then MISSING="$MISSING $grp"; fi
done
if [ -n "$MISSING" ]; then
  echo "ERROR: this shell is missing project group(s):$MISSING" >&2
  echo "  Fix:  source ./ve-env   (or use a setup_agent worktree shell)" >&2
  exit 1
fi

if [ "$#" -ge 1 ]; then
    MSG_ARG="$1"
    shift

    # 1. Parse Message Content
    if [[ "$MSG_ARG" == @* ]]; then
        MSG_FILE="${MSG_ARG#@}"
        if [ -f "$MSG_FILE" ]; then
            COMMIT_MSG=$(cat "$MSG_FILE")
        else
            echo "Error: Message file '$MSG_FILE' not found."
            exit 1
        fi
    else
        COMMIT_MSG="$MSG_ARG"
    fi

    # 2. Add Specified Files Explicitly
    # No implicit adds or wildcards allowed.
    ADDED_COUNT=0
    for file in "$@"; do
        if [ -e "$file" ]; then
            git add "$file"
            ADDED_COUNT=$((ADDED_COUNT + 1))
        else
            echo "Warning: File '$file' not found. Skipping."
        fi
    done

    # 3. Commit Phase
    # Check for staged changes (either from args above or pre-staged)
    STAGED_CHANGES=$(git diff --cached --name-only)
    if [ -n "$STAGED_CHANGES" ]; then
        if [ -n "$COMMIT_MSG" ]; then
            git commit -m "$COMMIT_MSG"
            if [ $? -ne 0 ]; then
                echo "Error: Git commit failed."
                exit 1
            fi
        else
            echo "Error: Staged changes exist but no commit message provided."
            exit 1
        fi
    else
        if [ "$ADDED_COUNT" -gt 0 ]; then
            echo "Error: Files provided but nothing to commit (already matches repo?)."
            exit 1
        fi
        echo "Info: No new changes to commit. Proceeding to integrity check."
    fi
else
    echo "Info: No arguments provided. Skipping commit phase."
fi

# 4. Integrity Barrier: Strict 'git describe' protection
# Ensure NO modified tracked files remain. Everything MUST be in git.
DIRTY_FILES=$(git status --porcelain -uno)
if [ -n "$DIRTY_FILES" ]; then
    echo "CRITICAL ERROR: Uncommitted tracked files detected:"
    echo "$DIRTY_FILES"
    echo "------------------------------------------------------------------"
    echo "Every modified file MUST be explicitly added to the build command."
    echo "Compile aborted to ensure accurate 'git describe' versioning."
    exit 1
fi

# 5. Build Phase
if [ ! -x ./gradlew ]; then
    echo "Info: No ./gradlew here (orchestration root or non-app tree). Skipping Gradle build."
    echo "If this is the app tree, cd into it first (e.g. cd master)."
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ "$CURRENT_BRANCH" == "master" ]; then
        TAG_NAME="builds"
    else
        TAG_NAME="${CURRENT_BRANCH}/builds"
    fi
    echo "Updating '$TAG_NAME' tag (no compile performed)."
    git tag -f "$TAG_NAME"
    git describe --tags --match "${CURRENT_BRANCH}-start" 2>/dev/null || git describe
    exit 0
else
    # Separate user args from gradle flags after --
    GRADLE_ARGS=()
    REMAINING_ARGS=()
    SEEN_DASHDASH=false
    for arg in "$@"; do
      if [ "$SEEN_DASHDASH" = true ]; then
        GRADLE_ARGS+=("$arg")
      elif [ "$arg" = "--" ]; then
        SEEN_DASHDASH=true
      else
        REMAINING_ARGS+=("$arg")
      fi
    done
    if [ ${#GRADLE_ARGS[@]} -gt 0 ]; then
      echo "Passing gradle flags: ${GRADLE_ARGS[*]}"
    fi
    # Homes under this worktree. orch_root is read/seed only (keystore copy).
    _BA_HERE="$(cd "$(dirname "$0")" && pwd)"
    if [ ! -f "$_BA_HERE/ve-resolve-orch" ]; then
      echo "ERROR: missing $_BA_HERE/ve-resolve-orch (run ./update-rules.sh from orchestration root)." >&2
      exit 1
    fi
    # shellcheck source=/dev/null
    . "$_BA_HERE/ve-resolve-orch"
    ve_resolve_orch "$_BA_HERE" || exit 1
    ve_setup_worktree_build_homes "$_BA_HERE" || exit 1
    ve_reset_gradle_daemon_dir || exit 1
    ve_wipe_foreign_app_build_outputs || exit 1
    unset GRADLE_OPTS
    PLANNING_USER=$(sed -n 's/^planning_user=//p' project.config 2>/dev/null | tr -d '\r' | head -1)
    PLANNING_USER=${PLANNING_USER:-ai-planner}
    if [ "$(id -un)" = "$PLANNING_USER" ]; then
      echo "ERROR: Planning agents must not run Gradle builds. Policy violation."
      exit 1
    fi
    # Always go through build_app — direct gradlew/gradlew.bat is forbidden (breaks integrity, perms, tags).
    GRADLE_CMD=( "${GRADLE_ARGS[@]}" assembleDebug )
    # No daemon: multi-worktree RAM; agent path does not keep Gradle daemons warm.
    (umask 007; ./gradlew --no-daemon --no-configuration-cache \
      -Pkotlin.compiler.execution.strategy=in-process \
      -Dkotlin.compiler.execution.strategy=in-process "${GRADLE_CMD[@]}")
    RET_VAL=$?
    ve_reset_gradle_daemon_dir || exit 1

    # Post-build permission repair for this worktree only (not orch caches).
    for gdir in .gradle app/build; do
      if [ -d "$gdir" ]; then
        echo "Quick $gdir permission repair (group sync + setgid + ug+rwX)..."
        chgrp -R ai-code "$gdir" 2>/dev/null || true
        find "$gdir" -type d -exec chmod 2770 {} + 2>/dev/null || true
        chmod -R ug+rwX,o-rwx "$gdir" 2>/dev/null || true
      fi
    done

    # Assert group-writable dirs under app/build (2755 blocks other users' deploy wipe).
    if [ -d app/build ]; then
      BAD_DIRS=$(find app/build -type d ! -perm -g+w 2>/dev/null | head -20)
      if [ -n "$BAD_DIRS" ]; then
        echo "Re-applying group-write on non-group-writable app/build dirs..."
        echo "$BAD_DIRS" | while read -r d; do chmod g+rwX "$d" 2>/dev/null || true; done
        find app/build -type d -exec chmod 2770 {} + 2>/dev/null || true
        BAD_DIRS=$(find app/build -type d ! -perm -g+w 2>/dev/null | head -10)
        if [ -n "$BAD_DIRS" ]; then
          BAD_N=$(find app/build -type d ! -perm -g+w 2>/dev/null | wc -l | tr -d ' ')
          echo "WARN: $BAD_N app/build dir(s) still lack group write (other users cannot wipe/deploy)."
          echo "  Sample:"
          echo "$BAD_DIRS" | while read -r d; do ls -ld "$d" 2>/dev/null; done
          echo "  Fix as owner: find app/build -type d -exec chmod 2770 {} +"
        else
          echo "Build tree group-writable: OK (after re-chmod)"
        fi
      else
        echo "Build tree group-writable: OK"
      fi
    fi

    # Source tree target modes: dirs 2775, files 664 (planner other-read + group write)
    if [ -d app/src ]; then
      find app/src -type d -exec chmod 2775 {} + 2>/dev/null || true
      find app/src -type f -exec chmod 664 {} + 2>/dev/null || true
    fi

    if [ $RET_VAL -eq 0 ]; then
        CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
        if [ "$CURRENT_BRANCH" == "master" ]; then
            TAG_NAME="builds"
        else
            TAG_NAME="${CURRENT_BRANCH}/builds"
        fi
        echo "Build successful. Updating '$TAG_NAME' tag."
        git tag -f "$TAG_NAME"
        git describe --tags --match "${CURRENT_BRANCH}-start" 2>/dev/null || git describe
        exit 0
    else
        echo "Build failed."
        exit 1
    fi
fi

#!/bin/bash
set -e

git reset --hard HEAD
git clean -fd
echo "sdk.dir=$HOME/Android/Sdk" > local.properties


echo "🧨 SUPER-AGGRESSIVE FULL CACHE NUKE"
echo "=================================="

echo "→ Stopping Gradle daemons..."
./gradlew --stop 2>/dev/null || true

echo "→ Killing all Gradle/Kotlin/KSP processes..."
pkill -9 -f GradleDaemon 2>/dev/null || true
pkill -9 -f gradle 2>/dev/null || true
pkill -9 -f ksp 2>/dev/null || true
pkill -9 -f kotlin 2>/dev/null || true
pkill -9 -f studio 2>/dev/null || true



echo "→ Deleting ALL caches..."
rm -rf .gradle/ app/build/ build/ ~/.gradle/caches/ ~/.gradle/daemon/ ~/.gradle/build-cache/ ~/.gradle/kotlin-dsl/ ~/.gradle/.cache/ .kotlin/ app/.kotlin/

# Extra KSP-specific directories the normal nuke misses

rm -rf app/build/generated/ksp/ app/build/tmp/ksp/ app/build/intermediates/ksp/ app/build/ksp/ .ksp/ app/build/generated/ app/build/tmp/ .idea/



echo "✅ Super nuke complete."
echo "→ Starting fresh build with full dependency refresh..."
./gradlew clean build --refresh-dependencies --no-daemon

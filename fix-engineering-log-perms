#!/bin/bash
# fix-engineering-log-perms
#
# Focused, reliable fixer for:
#   - append-to-engineering-log  (blessed wrapper, owned root:shared, 755/setgid, pure Unix)
#   - ENGINEERING_LOG.md         (root:shared 660 + chattr +a for append-only protection)
#
# Pure Unix model: owner/group/other + setgid where appropriate, chattr +a on log.
# No ACLs.
#
# This ensures controlled append-only logging and that the wrapper works for ai-* users
# via group/other perms + setgid.
#
# === IMPORTANT: You only need to run this ONCE from the main directory ===
#
#   cd ~/git/VehicleExpenses-automated
#   sudo ./fix-engineering-log-perms
#
# It automatically discovers the main orchestration checkout + ALL worktrees
# using `git worktree list` and fixes the wrapper + log (ownership, modes, chattr +a)
# in every single one of them.
# It also installs the sudoers rules.
#
# You do **not** have to cd into each worktree and run it again.
# Running the copy that lives inside a worktree is also fine — it will
# still see the full list via `git worktree list`.
#
# If you ever only want one specific tree:
#   sudo ./fix-engineering-log-perms /path/to/some.wt
#
# Run as root (sudo). It also ensures the right users are in ai-shared.

set -euo pipefail

umask 007

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR" && git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Load config (same style as set-worktree-perms)
if [ -f "$SCRIPT_DIR/project.config" ]; then
  . <(sed 's/=/ /; s/^/export /' "$SCRIPT_DIR/project.config" | grep -E '^(code_group|shared_group|docker_group|orchestrator_user|planning_user|coder_user)')
fi

CODE_GROUP=${code_group:-ai-code}
SHARED_GROUP=${shared_group:-ai-shared}
DOCKER_GROUP=${docker_group:-docker}
ORCHESTRATOR_USER=${orchestrator_user:-ai-orchestrator}
PLANNING_USER=${planning_user:-ai-planner}
CODER_USER=${coder_user:-ai-coder}

# Canonical good content for the append wrapper (with sudo fallback for resilience).
# This is the single source of truth installed into every tree.
CANONICAL_APPEND_WRAPPER=$(cat << 'WRAPPER_EOF'
#!/bin/bash
# append-to-engineering-log
# Controlled wrapper for appending ONLY to ENGINEERING_LOG.md.
# Agents MUST use this (never direct edits or >>).
# chattr +a on the log prevents modification of existing lines even if someone
# has write permission.

set -euo pipefail

# Locate the worktree root reliably.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  ROOT=$(git rev-parse --show-toplevel)
else
  ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

LOGFILE="$ROOT/ENGINEERING_LOG.md"
if [ ! -f "$LOGFILE" ]; then
  echo "ERROR: $LOGFILE not found" >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  echo "Usage: $(basename "$0") '## YYYY-MM-DD - Title\n\n- bullet ...'" >&2
  echo "   or: $(basename "$0") @file-with-entry.txt" >&2
  exit 1
fi

if [[ "$1" == @* ]]; then
  f="${1#@}"
  if [ -f "$f" ]; then
    ENTRY=$(cat "$f")
  else
    echo "ERROR: $f not found" >&2
    exit 1
  fi
else
  ENTRY="$*"
fi

# Enforce the required dated header format.
if [[ ! $ENTRY =~ ^##\ [0-9]{4}- ]]; then
  echo "ERROR: Entry must start with '## YYYY-MM-DD - ...'" >&2
  exit 1
fi

# Perform the append. If it fails due to permissions (ACL/mask/group not yet
# active for this uid, new worktree, etc.) and we are not root, transparently
# re-execute via sudo. The sudoers policy allows ai-planner/ai-coder/
# ai-orchestrator + dlang to run this exact command as root with NOPASSWD.
do_append() {
  if printf '\n%s\n' "$ENTRY" >> "$LOGFILE" 2>/dev/null; then
    return 0
  fi

  if [ "$EUID" -ne 0 ]; then
    SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")
    echo "Direct append denied for $(id -un); retrying as root via sudo (allowed by policy)..." >&2
    exec sudo -n -- "$SCRIPT_PATH" "$@"
  fi

  echo "ERROR: cannot append to $LOGFILE even as root" >&2
  exit 1
}

do_append "$@"

echo "Appended entry to ENGINEERING_LOG.md"
WRAPPER_EOF
)

# Collect target worktrees.
# We always use `git worktree list` so it works correctly no matter which
# copy of this script you invoke (the one in the main tree, or inside agent-N/ etc.).
declare -A SEEN
TARGETS=()

add_target() {
  local p="$1"
  [ -z "$p" ] && return
  p="$(cd "$p" 2>/dev/null && pwd)" || return
  if [ -z "${SEEN[$p]:-}" ]; then
    SEEN[$p]=1
    TARGETS+=("$p")
  fi
}

# Always collect the complete list from git. This gives us the main
# orchestration checkout + every worktree (agent-*, master, *.wt, etc.).
while IFS= read -r line; do
  if [[ $line == worktree* ]]; then
    wt=${line#worktree }
    add_target "$wt"
  fi
done < <(git worktree list --porcelain 2>/dev/null || true)

# Also pick up any explicit path argument.
for arg in "$@"; do
  case "$arg" in
    --all|--help|-h) ;;  # handled below
    *)
      if [ -d "$arg" ]; then
        add_target "$arg"
      fi
      ;;
  esac
done

# Handle flags
DO_ALL=false
for arg in "$@"; do
  case "$arg" in
    --all) DO_ALL=true ;;
    --help|-h)
      echo "Usage: sudo $0 [--all] [optional/path/to/one/worktree]"
      echo ""
      echo "Recommended:"
      echo "    cd ~/git/VehicleExpenses-automated"
      echo "    sudo ./fix-engineering-log-perms"
      echo ""
      echo "This fixes the main checkout + ALL worktrees in one go."
      echo "You do not need to cd into each worktree and run it separately."
      exit 0
      ;;
  esac
done

if [ "$DO_ALL" = true ] || [ ${#TARGETS[@]} -eq 0 ]; then
  echo "(operating on all worktrees discovered via git worktree list)"
fi

if [ ${#TARGETS[@]} -eq 0 ]; then
  echo "ERROR: Could not discover any worktrees."
  exit 1
fi

echo "=== fix-engineering-log-perms ==="
echo "SHARED_GROUP=$SHARED_GROUP  PLANNING_USER=$PLANNING_USER"
echo "Targets: ${#TARGETS[@]}"
for t in "${TARGETS[@]}"; do echo "  $t"; done
echo

require_root_or_die() {
  if [ "$EUID" -ne 0 ]; then
    echo "ERROR: Must run as root. Use: sudo ./fix-engineering-log-perms" >&2
    exit 1
  fi
}
require_root_or_die

# Ensure the human + ai-* users are in the shared group (so 660 + group works even without ACLs).
echo "Ensuring group memberships for $SHARED_GROUP ..."
for u in dlang "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
  if id "$u" >/dev/null 2>&1; then
    usermod -aG "$SHARED_GROUP" "$u" 2>/dev/null || true
    echo "  + $u -> $SHARED_GROUP"
  fi
done
# Also make sure planner is not in the code group (defense in depth).
gpasswd -d "$PLANNING_USER" "$CODE_GROUP" 2>/dev/null || true

# Install / update sudoers rules (full set) so that:
# - dlang can sudo -u ai-* the grok binary (run-grok-planner / run-grok-master etc. no password)
# - ai-* + dlang can sudo the append wrapper as root (the fallback path)
# - dlang can sudo the fix scripts
# This also covers the case where run-grok-planner was prompting for sudo password.
echo "Installing/updating sudoers rules for append wrapper elevation..."
cat > /etc/sudoers.d/vehicle-permissions << 'SUDOEOF'
# VehicleExpenses multi-agent sudoers (generated by fix-engineering-log-perms)
# Allows:
# - dlang to run the grok binary as ai-* users (for run-grok-*, run-grok-planner etc.) without password
# - ai-* users and dlang to run the append wrapper (and some fix scripts) as root without password

dlang ALL=(ai-planner,ai-coder,ai-orchestrator) NOPASSWD: /home/dlang/git/grok/bin/grok

ai-planner,ai-coder,ai-orchestrator ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/append-to-engineering-log
ai-planner,ai-coder,ai-orchestrator ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/append-to-engineering-log
ai-planner,ai-coder,ai-orchestrator ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/*/append-to-engineering-log

dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/append-to-engineering-log
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/append-to-engineering-log
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/*/append-to-engineering-log

dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/set-worktree-perms
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/set-worktree-perms

dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/fix-engineering-log-perms
SUDOEOF

chmod 440 /etc/sudoers.d/vehicle-permissions
if visudo -c >/dev/null 2>&1; then
  echo "  sudoers installed and validated."
else
  echo "  WARNING: sudoers written but visudo -c reported an issue. Check /etc/sudoers.d/vehicle-permissions"
fi

fixed=0
for wt in "${TARGETS[@]}"; do
  echo ">>> Fixing $wt"

  # 1. The wrapper (install canonical content + correct ownership/mode/ACLs).
  WRAPPER="$wt/append-to-engineering-log"
  if [ -d "$wt" ]; then
    # Write the canonical good wrapper (this also upgrades any old copy).
    printf '%s' "$CANONICAL_APPEND_WRAPPER" > "$WRAPPER"
    chown root:"$SHARED_GROUP" "$WRAPPER" 2>/dev/null || true

    # Remove any restrictive chattr (e.g. if +a was mistakenly set) so chmod can succeed.
    chattr -a "$WRAPPER" 2>/dev/null || true

    chmod 755 "$WRAPPER" 2>/dev/null || true
    chmod -s "$WRAPPER" 2>/dev/null || true

    # Clear any previous restrictive ACLs (e.g. old rw- without x for dlang).
    setfacl -b "$WRAPPER" 2>/dev/null || true

    # Base mode for exec by group/other. (pure Unix, no ACLs)
    chmod 755 "$WRAPPER" 2>/dev/null || true

    # Note: previously added ACLs for planner/dlang here.
    # Removed for pure Unix model (owner/group/other + setgid/chattr where needed).

    chmod +x "$WRAPPER" 2>/dev/null || true
    echo "    wrapper: installed + root:$SHARED_GROUP 755 (pure Unix, no ACLs)"
    fixed=$((fixed+1))
  else
    echo "    (skipped - not a directory)"
    continue
  fi

  # 2. The log file.
  LOG="$wt/ENGINEERING_LOG.md"
  if [ -f "$LOG" ] || [ ! -e "$LOG" ]; then
    # Ensure the file exists.
    if [ ! -f "$LOG" ]; then
      touch "$LOG"
      # Seed a minimal header on first creation (optional but friendly).
      if [ ! -s "$LOG" ]; then
        printf "## (log initialized by fix-engineering-log-perms)\n\n" > "$LOG"
      fi
    fi

    # Must remove +a temporarily before chmod/setfacl (append-only blocks mode and ACL changes).
    chattr -a "$LOG" 2>/dev/null || true

    chown root:"$SHARED_GROUP" "$LOG" 2>/dev/null || true
    chmod 660 "$LOG" 2>/dev/null || true

    # Clear old restrictive ACLs (for pure Unix).
    setfacl -b "$LOG" 2>/dev/null || true

    # Restore append-only.
    chattr +a "$LOG" 2>/dev/null || echo "    (chattr +a failed or unsupported - run on XFS/ext4 etc.)"

    # Note: previously re-applied ACLs here for planner/dlang.
    # Removed to follow pure Unix (no ACLs) model. chattr +a + group perms provide the protection.

    # Make the directory traversable (for planner as other).
    chmod o+rx "$wt" 2>/dev/null || true

    echo "    log: root:$SHARED_GROUP 660 + chattr +a (pure Unix, no ACLs)"
    fixed=$((fixed+1))
  fi

  # 3. Make sure the wrapper is still executable after ACLs.
  [ -f "$WRAPPER" ] && chmod +x "$WRAPPER" 2>/dev/null || true
done

echo
echo "=== Done. Fixed wrapper + log in ${#TARGETS[@]} location(s). ==="
echo
echo "Quick verification (run in any worktree):"
echo "  ./append-to-engineering-log '## 2026-06-21 - test from dlang'"
echo "  sudo -u $PLANNING_USER ./append-to-engineering-log '## 2026-06-21 - test from planner'"
echo "  sudo -u $ORCHESTRATOR_USER ./append-to-engineering-log '## 2026-06-21 - test from orchestrator'"
echo "  tail -5 ENGINEERING_LOG.md"
echo
echo "If your current shell doesn't see the new group memberships yet:"
echo "  newgrp $SHARED_GROUP"
echo "  # or log out and back in"
echo
echo "To also push the (now fixed) append-to-engineering-log into other trees via the normal mechanism:"
echo "  sudo ./update-rules.sh"
echo
echo "Re-run this script any time after adding a new worktree or after permission drift."

#!/bin/bash
# set-sandbox-perms
# Applies 2770 setgid for sandbox (group write).
#
# This is infrastructure. After edits, commit in main then
# `sudo ./update-rules.sh` (agents idle) to sync to worktrees.
# Ensures permission scripts stay committed and not reverted.

set -euo pipefail

# Load config
if [ -f project.config ]; then
  . <(sed 's/=/ /; s/^/export /' project.config | grep -E '^(sandbox_group|shared_group|docker_group|planning_user|coder_user|orchestrator_user)')
fi

SANDBOX_GROUP=${sandbox_group:-@@SANDBOX_GROUP@@}
SHARED_GROUP=${shared_group:-@@SHARED_GROUP@@}
DOCKER_GROUP=${docker_group:-docker}
PLANNING_USER=${planning_user:-@@PLANNING_USER@@}
CODER_USER=${coder_user:-@@CODE_GROUP@@r}
ORCHESTRATOR_USER=${orchestrator_user:-@@ORCHESTRATOR_USER@@}

# If run via sudo, determine target owner for chowns and configs
SUDO_USER_VAL="${SUDO_USER:-}"
if [ -n "$SUDO_USER_VAL" ] && [ "$SUDO_USER_VAL" != "root" ]; then
  TARGET_OWNER="$SUDO_USER_VAL"
else
  TARGET_OWNER=""
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Discover sandbox locations: main one + any from worktrees (symlinks)
mapfile -t SANDBOX_CANDIDATES < <(echo "$SCRIPT_DIR/@@SANDBOX_PATH@@")
mapfile -t WORKTREES < <(git worktree list --porcelain 2>/dev/null | awk '/^worktree / {print $2}')
for wt in "${WORKTREES[@]}"; do
  if [ -L "$wt/@@SANDBOX_PATH@@" ]; then
    target=$(readlink -f "$wt/@@SANDBOX_PATH@@")
    [ -d "$target" ] && SANDBOX_CANDIDATES+=("$target")
  fi
done

# Unique
SANDBOX_DIRS=()
for dir in "${SANDBOX_CANDIDATES[@]}"; do
  [[ " ${SANDBOX_DIRS[*]} " != *" $dir "* ]] && SANDBOX_DIRS+=("$dir")
done

echo "Setting sandbox perms (2770 setgid for $SANDBOX_GROUP)..."

for SANDBOX_DIR in "${SANDBOX_DIRS[@]}"; do
  if [ ! -d "$SANDBOX_DIR" ]; then continue; fi
  echo "  Applying to sandbox: $SANDBOX_DIR"
  chown -R :$SANDBOX_GROUP "$SANDBOX_DIR" || true

  # Modify r/w only, preserve exe bit.
  chmod -R g+rwX "$SANDBOX_DIR" || true
  find "$SANDBOX_DIR" -type d -exec chmod u+rwx,g+rwxs,o+rx {} + || true

  # Preserve x on any critical scripts that might be inside the sandbox dir (e.g. template)
  EXECUTABLES=(
    setup-project
    filter-apply-config
    filter-clean-config
    set-worktree-perms
    set-sandbox-perms
    post-checkout
  )
  for f in "${EXECUTABLES[@]}"; do
    find "$SANDBOX_DIR" -name "$f" -type f -exec chmod +x {} + 2>/dev/null || true
  done

  # Also allow shared group if needed
  chown -R :$SHARED_GROUP "$SANDBOX_DIR" 2>/dev/null || true

  # Grant @@PLANNING_USER@@ full read/write/execute (and default ACLs for new files) inside the sandbox.
  # This is critical because planner is not a member of @@CODE_GROUP@@ (enforced elsewhere),
  # and group ownership may end up as @@CODE_GROUP@@/@@SHARED_GROUP@@ after other perms scripts.
  # Named ACL ensures planner can freely write plans/, historical-plans/, etc.
  if id "$PLANNING_USER" >/dev/null 2>&1; then
    setfacl -R -m "u:$PLANNING_USER:rwx" "$SANDBOX_DIR" 2>/dev/null || true
    setfacl -R -m "d:u:$PLANNING_USER:rwx" "$SANDBOX_DIR" 2>/dev/null || true
  fi

  # Git safe.directory for the sandbox's inner git (if present)
  if [ -d "$SANDBOX_DIR/.git" ]; then
    if [ -n "$TARGET_OWNER" ]; then
      sudo -u "$TARGET_OWNER" git config --global --add safe.directory "$SANDBOX_DIR" 2>/dev/null || true
    fi
    for aiuser in "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
      if [ -n "$aiuser" ] && id "$aiuser" >/dev/null 2>&1; then
        sudo -u "$aiuser" git config --global --add safe.directory "$SANDBOX_DIR" 2>/dev/null || true
      fi
    done
  fi

  # Also ensure the main project wildcard (user requested form) is set for this context
  # This covers the main tree + all worktrees from the sandbox perms run as well.
  if [ -n "$TARGET_OWNER" ]; then
    sudo -u "$TARGET_OWNER" git config --global --add safe.directory '/home/dlang/git/VehicleExpenses-automated/*' 2>/dev/null || true
  fi
  for aiuser in "$PLANNING_USER" "$CODER_USER" "$ORCHESTRATOR_USER"; do
    if [ -n "$aiuser" ] && id "$aiuser" >/dev/null 2>&1; then
      sudo -u "$aiuser" git config --global --add safe.directory '/home/dlang/git/VehicleExpenses-automated/*' 2>/dev/null || true
    fi
  done
done

# Also ensure @@CODE_GROUP@@r and @@ORCHESTRATOR_USER@@ are in the docker group (for Paddle container workflows).
# This is a no-op if already a member.
usermod -aG $DOCKER_GROUP $CODER_USER 2>/dev/null || true
usermod -aG $DOCKER_GROUP $ORCHESTRATOR_USER 2>/dev/null || true
if [ -n "$SUDO_USER_VAL" ] && [ "$SUDO_USER_VAL" != "root" ]; then
  usermod -aG $DOCKER_GROUP "$SUDO_USER_VAL" 2>/dev/null || true
fi

echo "Sandbox perms applied."

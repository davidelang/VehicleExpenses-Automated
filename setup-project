#!/bin/bash
# setup-project
# ONE-TIME PERMISSION STAMP / bootstrap for permissions model.
# This is a stamp: copy the emitted artifacts + stampable files (set-*-perms,
# project.config.example, filter-*-config, .gitattributes snippets, etc.) into a
# target project ONCE. After stamping, the target project OWNS the files with
# no permanent back-references to the source orchestration tree or any other project.
# Walks user through: users (emit only, NEVER auto), config, filters, hook, perms, sandbox.
# Mechanism not policy: flexible for dirs + unzip skeleton.
# Sandbox only mode: all work here; manual apply later.
# Always use absolute sandbox path for writes.
# Language-agnostic: adapt for any project layout; do not assume app/ paths.

set -euo pipefail

SANDBOX="/home/dlang/git/VehicleExpenses-automated/@@SANDBOX_PATH@@"
CONFIG_EXAMPLE="$SANDBOX/project.config.example"
CONFIG_REAL="$SANDBOX/project.config"
EXEC_DIR="$SANDBOX/permissions-bootstrap-execution"

echo "=== setup-project: Unix Permissions Bootstrap (sandbox-only, ONE-TIME STAMP) ==="
echo "All artifacts prepared in $EXEC_DIR for manual apply to trees."
echo "This is a ONE-TIME stamp. Target project owns the resulting files thereafter."
echo "Never auto-executes user creation."

# 1. Users (emit only)
echo ""
echo "=== Step 1: Unix users/groups (EMIT ONLY - review and run manually as root) ==="
cat <<'USERCMDS'
# Recommended (adjust names from project.config):
groupadd @@CODE_GROUP@@ || true
groupadd @@SANDBOX_GROUP@@ || true
groupadd @@SHARED_GROUP@@ || true
useradd -m -g @@SANDBOX_GROUP@@ @@PLANNING_USER@@ || true
useradd -m -g @@CODE_GROUP@@ @@CODE_GROUP@@r || true
useradd -m -g @@CODE_GROUP@@ -G @@SHARED_GROUP@@ @@ORCHESTRATOR_USER@@ || true
usermod -aG @@CODE_GROUP@@ @@ORCHESTRATOR_USER@@ || true
usermod -aG @@CODE_GROUP@@,@@SHARED_GROUP@@ @@PLANNING_USER@@ || true
usermod -aG @@SANDBOX_GROUP@@,@@SHARED_GROUP@@ @@CODE_GROUP@@r || true
usermod -aG @@SANDBOX_GROUP@@ @@ORCHESTRATOR_USER@@ || true
# Add the primary human/developer user (the one running setup) to @@CODE_GROUP@@ so they can access worktree files via group
# Replace 'dlang' with your username if different
usermod -aG @@CODE_GROUP@@ dlang || true
echo "Users created (if not exist)."
echo "IMPORTANT: If you are dlang (or the developer), run 'newgrp @@CODE_GROUP@@' or log out/in so your current shell sees the group."

# Git safe.directory (critical for modern git >= 2.35.2)
# Git refuses to operate in a repo "owned by someone else" unless the path is whitelisted.
# Use the wildcard form so any subdirectory, worktree, or sandbox created under the project is trusted.
# These must be executed as each relevant user (the human + the ai-* users).
echo "# For each user who will use git in this project (run the command as that user):"
echo "git config --global --add safe.directory '/home/dlang/git/VehicleExpenses-automated/*'"
echo ""
echo "# Examples (as root you can use sudo -u):"
echo "#   sudo -u dlang            git config --global --add safe.directory '/home/dlang/git/VehicleExpenses-automated/*'"
echo "#   sudo -u @@ORCHESTRATOR_USER@@  git config --global --add safe.directory '/home/dlang/git/VehicleExpenses-automated/*'"
echo "#   sudo -u @@CODE_GROUP@@r         git config --global --add safe.directory '/home/dlang/git/VehicleExpenses-automated/*'"
echo "#   sudo -u @@PLANNING_USER@@       git config --global --add safe.directory '/home/dlang/git/VehicleExpenses-automated/*'"
echo ""
echo "This wildcard is the recommended form because it will automatically cover any future worktrees or sandboxes."
echo "# STAMP NOTE: These paths are for the CURRENT project. When stamping a different"
echo "# clone/project, replace the paths with the target's root. The stamped files become"
echo "# owned by the target; no link back to this orchestration source is required."

# Passwordless sudo for launchers (so no password prompt for sudo -u ai-*)
cat <<'SUDOERS'
# Run as root to set up passwordless sudo:
cat > /etc/sudoers.d/vehicle-permissions << 'EOF'
dlang ALL=(@@PLANNING_USER@@,@@CODE_GROUP@@r,@@ORCHESTRATOR_USER@@) NOPASSWD: /home/dlang/git/grok/bin/grok
EOF
chmod 440 /etc/sudoers.d/vehicle-permissions
visudo -c   # validate
SUDOERS
echo "Review and run the sudoers setup above as root. Then no password for sudo in launchers."
echo "# ONE-TIME STAMP: After applying to the target tree, the permission files (set-*-perms etc.)"
echo "# are owned by that tree. Edit the generated sudoers for the actual target location."
USERCMDS
echo "Review above. Do NOT run automatically."

# As a convenience, configure safe.directory for the *current* user right now
# (the human running the bootstrap). We compute the current git root + wildcard.
# STAMP: this auto-add is a helper for the running user on this tree; when stamping
# a brand new independent project, the receiver will run equivalent for their paths.
CURRENT_USER=$(id -un)
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
git config --global --add safe.directory "$PROJECT_ROOT/*" 2>/dev/null || true
echo "Automatically added safe.directory wildcard for current user ($CURRENT_USER) on $PROJECT_ROOT/*"
echo "You still need to do the equivalent for the ai-* users (see the USERCMDS above, adapting the path for the target project)."

# 2. Config
echo ""
echo "=== Step 2: Config ==="
if [ ! -f "$CONFIG_REAL" ]; then
  if [ -f "$CONFIG_EXAMPLE" ]; then
    cp "$CONFIG_EXAMPLE" "$CONFIG_REAL"
    echo "Created $CONFIG_REAL from example. EDIT IT NOW with real values."
    echo "Then re-run this or filters will warn."
  else
    echo "ERROR: No example. Create $CONFIG_REAL manually."
  fi
else
  echo "$CONFIG_REAL exists."
fi

# 3. Git filters (manage-configs)
echo ""
echo "=== Step 3: Activate filters (run in tree root) ==="
cat <<'FILTERS'
git config filter.manage-configs.clean ./filter-clean-config
git config filter.manage-configs.smudge ./filter-apply-config
echo "Filters activated. Ensure .gitattributes has the patterns."
FILTERS

# 4. .gitattributes (prepared in staged)
echo "See staged/.gitattributes.add for the entries to merge."

# 5. Hook (post-checkout)
echo ""
echo "=== Step 4: Post-checkout hook (prepared) ==="
echo "Install .git/hooks/post-checkout that calls set-*-perms and verifies filters."
echo "Template in staged/post-checkout-hook.txt"

# 6. Sandbox
echo ""
echo "=== Step 5: Sandbox setup ==="
if [ -f "$CONFIG_REAL" ]; then
  . <(grep -E 'sandbox_path|sandbox_special_paths' "$CONFIG_REAL" | sed 's/=/ /')
  if [ -n "${sandbox_path:-}" ]; then
    mkdir -p "$SANDBOX/$sandbox_path"
    echo "Sandbox dir ensured: $sandbox_path"
    # special paths
    if [ -n "${sandbox_special_paths:-}" ]; then
      for p in $(echo $sandbox_special_paths | tr ',' ' '); do
        mkdir -p "$SANDBOX/$sandbox_path/$p"
      done
    fi
    # Inner git if not present
    if [ ! -d "$SANDBOX/$sandbox_path/.git" ]; then
      (cd "$SANDBOX/$sandbox_path" && git init) || echo "git init skipped or failed"
    else
      echo "Sandbox already has .git (from skeleton zip?)"
    fi
  fi
fi

# 7. Perms
echo ""
echo "=== Step 6: Apply perms ==="
echo "Run (with sudo if needed): ./fix-perms"
echo "Prepared in staged/"

# 8. Skeleton unzip (general mechanism)
echo ""
echo "=== Step 7: Skeleton (if declared in config) ==="
echo "Unzip support prepared. Example: unzip skeleton.zip -d $sandbox_path"

echo ""
echo "=== Bootstrap complete in sandbox. ==="
echo "All files in $EXEC_DIR/staged/ ready for ONE-TIME manual copy into the TARGET project tree."
echo "After copy, the stamped files (fix-perms, setup-project, filters, .gitattributes, project.config*, enable-full-orchestration.sh*) are OWNED by the target project."
echo "No permanent reference back to the stamp source is needed or created for other projects."
echo "Then apply (users, sudoers, filters, perms, hooks)."
echo "In the stamped tree run ./enable-full-orchestration.sh (or --apply after review) to opt into full layout from plain master."
echo "Adapt paths for the target tree location. Re-run any project steps after apply."

# Log
echo "setup-project ran at $(date)" >> "$EXEC_DIR/setup-project.log"

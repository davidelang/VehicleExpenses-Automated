#!/bin/bash
export GEMINI_PROJECT_ROOT=$(pwd)
# Support -- to pass raw params to gemini.
EXTRA_ARGS=()
FOUND_DD=0
for arg in "$@"; do
  if [ "$FOUND_DD" -eq 1 ]; then
    EXTRA_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    FOUND_DD=1
  fi
done
~/git/gemini/bin/gemini -i "Read new_agent_prompt and follow its instructions." --include-directories ~/git/VehicleExpenses-automated/dev-ai-interaction/ "${EXTRA_ARGS[@]}"

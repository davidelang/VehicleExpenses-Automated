#!/bin/bash
# fix-sudoers
#
# (Re)installs the complete sudoers rules needed for the multi-agent setup:
#   - dlang can run the grok binary as ai-planner/ai-coder/ai-orchestrator (so
#     run-grok-planner, run-grok-master etc. do not prompt for password)
#   - ai-* users + dlang can elevate to root only for the append wrapper (for
#     the fallback when direct write to ENGINEERING_LOG.md is denied by ACLs)
#   - dlang can run the various fix-* scripts as root without password
#
# Run:  sudo ./fix-sudoers
#
# This is the authoritative place for the vehicle-permissions sudoers.
# Re-run after any change to launchers or perms scripts.
#
# After editing, commit in main tree and run `sudo ./update-rules.sh`
# (agents idle) to propagate and commit into worktrees.

set -euo pipefail

if [ "$EUID" -ne 0 ]; then
  echo "ERROR: must be run as root"
  echo "  sudo $0"
  exit 1
fi

echo "Installing sudoers for VehicleExpenses append wrapper..."

cat > /etc/sudoers.d/vehicle-permissions << 'SUDOEOF'
# VehicleExpenses multi-agent sudoers (generated by fix-sudoers)
# Allows:
# - dlang to run the grok binary as ai-* users (for run-grok-*, run-grok-planner etc.) without password
# - ai-* users and dlang to run the append wrapper (and some fix scripts) as root without password
# No requiretty (for non-interactive harnesses)

dlang ALL=(ai-planner,ai-coder,ai-orchestrator) NOPASSWD: /home/dlang/git/grok/bin/grok

ai-planner,ai-coder,ai-orchestrator ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/append-to-engineering-log
ai-planner,ai-coder,ai-orchestrator ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/append-to-engineering-log
ai-planner,ai-coder,ai-orchestrator ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/*/append-to-engineering-log

dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/append-to-engineering-log
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/append-to-engineering-log
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/*/append-to-engineering-log

dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/set-worktree-perms
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/*/set-worktree-perms

dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/fix-engineering-log-perms
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/fix-this-worktree
dlang ALL=(root) NOPASSWD: /home/dlang/git/VehicleExpenses-automated/fix-sudoers
SUDOEOF

chmod 440 /etc/sudoers.d/vehicle-permissions

if visudo -c >/dev/null 2>&1; then
  echo "Done. sudoers validated."
else
  echo "WARNING: written, but visudo -c reported a problem. Inspect /etc/sudoers.d/vehicle-permissions"
fi

echo
echo "Now the wrapper's internal sudo fallback should work for the ai users."

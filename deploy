fi

if [ "$INSTALL_DATA" = "true" ]; then
  echo "=== --install-data: standalone data install from selected backup (no build, no uninstall) ==="
  local BACKUP_TO_USE="$SELECTED_BACKUP"
  if [ -z "$BACKUP_TO_USE" ]; then
    echo "No backup specified. Available:"
    ls -td test-data-backups/* 2>/dev/null || echo "(none)"
    echo 'Usage: ./deploy --install-data test-data-backups/<name> [dev...]'
    exit 1
  fi
  if [ ! -d "$BACKUP_TO_USE" ] && [ -d "test-data-backups/$BACKUP_TO_USE" ]; then
    BACKUP_TO_USE="test-data-backups/$BACKUP_TO_USE"
  fi
  if [ ! -d "$BACKUP_TO_USE" ]; then
    echo "Backup directory not found: $BACKUP_TO_USE"
    exit 1
  fi
  if [ ${#TARGETS[@]} -eq 0 ]; then
    mapfile -t ALL_DEVICES < <(adb devices | awk '$2 == "device" {print $1}')
    if [ ${#ALL_DEVICES[@]} -eq 0 ]; then
      echo "No connected devices found."
      exit 1
    fi
    for DEVICE_ID in "${ALL_DEVICES[@]}"; do
      restore_test_data "$DEVICE_ID" "$BACKUP_TO_USE"
    done
  else
    for TARGET in "${TARGETS[@]}"; do
      if [ -z "$TARGET" ]; then continue; fi
      DEVICE_ID="${DEVICE_MAP["$TARGET"]:-$TARGET}"
      echo "Installing to $TARGET ($DEVICE_ID)..."
      restore_test_data "$DEVICE_ID" "$BACKUP_TO_USE"
    done
  fi
  echo "=== --install-data complete ==="
  exit 0
fi

OVERALL_SUCCESS=true

if [ ${#TARGETS[@]} -eq 0 ]; then
    echo "Deploying to all connected devices..."
    # Discover all connected online devices so we can clear logcat on each
    mapfile -t ALL_DEVICES < <(adb devices | awk '$2 == "device" {print $1}')
    if [ ${#ALL_DEVICES[@]} -eq 0 ]; then
        echo "No connected devices found."
        OVERALL_SUCCESS=false
    else
        if [ ! -x ./gradlew ]; then
            echo "Error: ./gradlew not found or not executable here."
            echo "Run from inside an app worktree, e.g.: cd master && ../deploy   or cd agent-1 && ../deploy"
            echo "See README-multi-agent.md for the proper workflow."
            OVERALL_SUCCESS=false
        else
            for DEVICE_ID in "${ALL_DEVICES[@]}"; do
                backup_test_data "$DEVICE_ID"
            done

            # SAFETY: When PRESERVE_DATA is requested, we must NOT uninstall if we
            # failed to capture the data (DB + reference images for dash/pump/alignment).
            # This prevents "told to preserve, but deleted anyway and then build failed".
            PRESERVE_ABORT=false
            if [ "$PRESERVE_DATA" = "true" ]; then
                for DEVICE_ID in "${ALL_DEVICES[@]}"; do
                    LATEST=$(ls -td test-data-backups/"${DEVICE_ID}"-* 2>/dev/null | head -1 || true)
                    has_backup=false
                    if [ -n "$LATEST" ]; then
                        if [ -f "$LATEST/vehicle_expenses.db.bak" ] && [ -s "$LATEST/vehicle_expenses.db.bak" ]; then
                            has_backup=true
                        fi
                        for img in vehicle_refs.tar.gz pump_photos.tar.gz alignment_photos.tar.gz; do
                            if [ -f "$LATEST/$img" ] && [ -s "$LATEST/$img" ]; then
                                has_backup=true
                                break
                            fi
                        done
                    fi
                    # Check if the package is currently installed on the device
                    pkg_check=$(adb -s "$DEVICE_ID" shell "pm list packages $PACKAGE_NAME" 2>/dev/null || true)
                    if echo "$pkg_check" | grep -q "$PACKAGE_NAME"; then
                        if [ "$has_backup" != "true" ]; then
                            echo "  [preserve] CRITICAL SAFETY ABORT: $DEVICE_ID has the app installed, but backup captured neither DB nor test images (dash refs / pump / alignment photos)."
                            echo "  Refusing to uninstall — we will not destroy your data when backup failed."
                            PRESERVE_ABORT=true
                        fi
                    fi
                done
            fi

            if [ "${UNINSTALL_FIRST:-false}" = "1" ] || [ "${UNINSTALL_FIRST:-false}" = "true" ] || [ "$PRESERVE_DATA" = "true" ]; then
                if [ "$PRESERVE_DATA" = "true" ] && [ "$PRESERVE_ABORT" = "true" ]; then
                    echo "  [preserve] Skipping uninstalls to protect data (see CRITICAL SAFETY ABORT above)."
                else
                    for DEVICE_ID in "${ALL_DEVICES[@]}"; do
                        echo "Uninstalling existing package on $DEVICE_ID..."
                        adb -s "$DEVICE_ID" uninstall $PACKAGE_NAME || true
                    done
                fi
            fi

            if [ "$PRESERVE_DATA" = "true" ] && [ "$PRESERVE_ABORT" = "true" ]; then
                echo "  [preserve] WARNING: App installed but no backup data captured (run-as couldn't read DB/images)."
                echo "  Will still build and attempt in-place install (no uninstall was done)."
            fi

            # Mitigate a very common Gradle failure when doing fresh installs:
            # "Unable to delete directory .../packageDebug/tmp" because a previous
            # daemon/worker still has files open (zip-cache, dex state, etc.).
            # Also handles cases where past root runs left files owned by root.
            # Extended to fix "unreadable inputs/outputs" / "Could not stat" errors
            # in Gradle 8+/9+ (CMake/cxx, navigation, assets, aar, etc. state).
            stop_gradle_daemons

            # Try to kill any lingering processes holding files in the incremental dirs.
            # This addresses "a process has files open".
            lsof +D app/build/intermediates/incremental 2>/dev/null | awk 'NR>1 {print $2}' | sort -u | xargs -r kill -9 2>/dev/null || true
            sleep 1

            # === STRONG PERM RECOVERY FOR UNREADABLE BUILD STATE ===
            # Some previous runs (root, wrong group, daemons) leave dirs/files
            # without read/x bits, causing Gradle to fail with "Could not stat file"
            # and "Accessing unreadable inputs or outputs".
            if [ -d app/build ]; then
                # First make directories traversable (x bit) so find/rm can work
                chmod -R u+rX,g+rX app/build 2>/dev/null || true
                # Full rw for user+group
                chmod -R u+rwX,g+rwX app/build 2>/dev/null || true
            fi

            # Aggressive removal of state that Gradle tracks and may have bad perms on
            rm -rf app/build/intermediates app/build/generated 2>/dev/null || true

            # Invalidate configuration cache (reusing it often causes "could not stat" after bad previous builds)
            rm -rf .gradle/configuration-cache* 2>/dev/null || true

            # If still problems, suggest manual sudo
            if [ -d app/build/intermediates ]; then
                echo "  WARNING: Could not fully remove app/build/intermediates."
                echo "  You may need: sudo chown -R $PRIMARY_USER:ai-code app/build ; rm -rf app/build/intermediates app/build/generated .gradle/configuration-cache*"
            fi

            (umask 007; ./gradlew --no-daemon --no-configuration-cache "${GRADLE_ARGS[@]}" installDebug)
            RET_VAL=$?
            repair_shared_cache
            if [ $RET_VAL -ne 0 ]; then
                echo "Deployment failed."
                OVERALL_SUCCESS=false
            else
                for DEVICE_ID in "${ALL_DEVICES[@]}"; do
                    restore_test_data "$DEVICE_ID"
                done
            fi

            # Clear logcat on *every* device we deployed to (important for multi-device)
            for DEVICE_ID in "${ALL_DEVICES[@]}"; do
                echo "Clearing logcat on $DEVICE_ID..."
                adb -s "$DEVICE_ID" logcat -c || echo "Warning: failed to clear logcat on $DEVICE_ID"
            done
        fi
    fi
else
    for TARGET in "${TARGETS[@]}"; do
        if [ -z "$TARGET" ]; then
            echo "Warning: skipping empty target from args"
            continue
        fi
        # Resolve alias if it exists, otherwise use the target as the literal device ID
        # Quote the subscript to safely handle empty TARGET (from arg parsing edge cases)
        DEVICE_ID="${DEVICE_MAP["$TARGET"]:-$TARGET}"
        
        echo "Deploying to $TARGET ($DEVICE_ID)..."
        if [ ! -x ./gradlew ]; then
            echo "Error: ./gradlew not found or not executable here."
            echo "cd into the worktree containing the app/ first."
            OVERALL_SUCCESS=false
            continue
        fi
        backup_test_data "$DEVICE_ID"

        # SAFETY: Same critical check as the all-devices path.
        PRESERVE_ABORT=false
        if [ "$PRESERVE_DATA" = "true" ]; then
            LATEST=$(ls -td test-data-backups/"${DEVICE_ID}"-* 2>/dev/null | head -1 || true)
            has_backup=false
            if [ -n "$LATEST" ]; then
                if [ -f "$LATEST/vehicle_expenses.db.bak" ] && [ -s "$LATEST/vehicle_expenses.db.bak" ]; then
                    has_backup=true
                fi
                for img in vehicle_refs.tar.gz pump_photos.tar.gz alignment_photos.tar.gz; do
                    if [ -f "$LATEST/$img" ] && [ -s "$LATEST/$img" ]; then
                        has_backup=true
                        break
                    fi
                done
                if [ -f "$LATEST/ve_source_zips.tar.gz" ] && [ -s "$LATEST/ve_source_zips.tar.gz" ]; then has_backup=true; fi
            fi
            pkg_check=$(adb -s "$DEVICE_ID" shell "pm list packages $PACKAGE_NAME" 2>/dev/null || true)
            if echo "$pkg_check" | grep -q "$PACKAGE_NAME"; then
                if [ "$has_backup" != "true" ]; then
                    echo "  [preserve] CRITICAL SAFETY ABORT: $DEVICE_ID has the app installed, but backup captured neither DB nor test images."
                    echo "  Refusing to uninstall to protect your dash/pump/alignment data."
                    PRESERVE_ABORT=true
                fi
            fi
        fi

        if [ "${UNINSTALL_FIRST:-false}" = "1" ] || [ "${UNINSTALL_FIRST:-false}" = "true" ] || [ "$PRESERVE_DATA" = "true" ]; then
            if [ "$PRESERVE_DATA" = "true" ] && [ "$PRESERVE_ABORT" = "true" ]; then
                echo "  [preserve] Skipping uninstall for $DEVICE_ID due to backup safety."
            else
                echo "Uninstalling existing package on $DEVICE_ID..."
                adb -s "$DEVICE_ID" uninstall $PACKAGE_NAME || true
            fi
        fi

        if [ "$PRESERVE_DATA" = "true" ] && [ "$PRESERVE_ABORT" = "true" ]; then
            echo "  [preserve] WARNING: App installed but no backup data captured (run-as couldn't read DB/images)."
            echo "  Will still build and attempt in-place install (no uninstall was done)."
        fi

        # Mitigate common Gradle "can't delete incremental tmp" failure
        # Extended for unreadable outputs in Gradle 8+/9+ (see other errors for cxx etc.)
        stop_gradle_daemons

        # Try to kill any lingering processes holding files in the incremental dirs.
        lsof +D app/build/intermediates/incremental 2>/dev/null | awk 'NR>1 {print $2}' | sort -u | xargs -r kill -9 2>/dev/null || true
        sleep 1

        # === STRONG PERM RECOVERY FOR UNREADABLE BUILD STATE ===
        # Some previous runs (root, wrong group, daemons) leave dirs/files
        # without read/x bits, causing Gradle to fail with "Could not stat file"
        # and "Accessing unreadable inputs or outputs".
        if [ -d app/build ]; then
            # First make directories traversable (x bit) so find/rm can work
            chmod -R u+rX,g+rX app/build 2>/dev/null || true
            # Full rw for user+group
            chmod -R u+rwX,g+rwX app/build 2>/dev/null || true
        fi

        # Aggressive removal of state that Gradle tracks and may have bad perms on
        rm -rf app/build/intermediates app/build/generated 2>/dev/null || true

        # Invalidate configuration cache (reusing it often causes "could not stat" after bad previous builds)
        rm -rf .gradle/configuration-cache* 2>/dev/null || true

        # If still problems, suggest manual sudo
        if [ -d app/build/intermediates ]; then
            echo "  WARNING: Could not fully remove app/build/intermediates."
            echo "  You may need: sudo chown -R $PRIMARY_USER:ai-code app/build ; rm -rf app/build/intermediates app/build/generated .gradle/configuration-cache*"
        fi

        (umask 007; ANDROID_SERIAL="$DEVICE_ID" ./gradlew --no-daemon --no-configuration-cache "${GRADLE_ARGS[@]}" installDebug)
        RET_VAL=$?
        repair_shared_cache
        if [ $RET_VAL -ne 0 ]; then
            echo "Deployment to $TARGET ($DEVICE_ID) failed."
            OVERALL_SUCCESS=false
        else
            restore_test_data "$DEVICE_ID"
        fi
        echo "Clearing logcat on $DEVICE_ID..."
        adb -s "$DEVICE_ID" logcat -c || echo "Warning: failed to clear logcat on $DEVICE_ID"
    done
fi

if [ "$OVERALL_SUCCESS" = true ]; then
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ "$CURRENT_BRANCH" == "master" ]; then
        TAG_NAME="deployed"
    else
        TAG_NAME="${CURRENT_BRANCH}/deployed"
    fi
    echo "All deployments successful. Updating '$TAG_NAME' tag."
    git tag -f "$TAG_NAME"
    git describe --tags --match "${CURRENT_BRANCH}-start" 2>/dev/null || git describe --always
    exit 0
else
    echo "One or more deployments failed. The 'deployed' tag was NOT updated."
    exit 1
fi

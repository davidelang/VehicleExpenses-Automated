      if [ -z "$TARGET" ]; then continue; fi
      DEVICE_ID="${DEVICE_MAP["$TARGET"]:-$TARGET}"
      echo "Pushing test data zips to $TARGET ($DEVICE_ID)..."
      push_source_zips_to_device "$DEVICE_ID" "$BACKUP_TO_USE"
    done
  fi
  echo "=== --push-test-data complete ==="
  return 0
}

run_backup_only_mode() {
  echo "=== --backup/--fetch-data: capture test data from device(s) only (no build, no uninstall) ==="
  if [ ${#TARGETS[@]} -eq 0 ]; then
    mapfile -t ALL_DEVICES < <(adb devices | awk '$2 == "device" {print $1}')
    if [ ${#ALL_DEVICES[@]} -eq 0 ]; then
      echo "No connected devices found."
      return 1
    fi
    for DEVICE_ID in "${ALL_DEVICES[@]}"; do
      backup_test_data "$DEVICE_ID"
    done
  else
    for TARGET in "${TARGETS[@]}"; do
      if [ -z "$TARGET" ]; then continue; fi
      DEVICE_ID="${DEVICE_MAP["$TARGET"]:-$TARGET}"
      echo "Backing up from $TARGET ($DEVICE_ID)..."
      backup_test_data "$DEVICE_ID"
    done
  fi
  echo "=== --backup/--fetch-data complete ==="
  return 0
}


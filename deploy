#!/bin/bash

# Usage: ./deploy [alias1 alias2 ...]
# If no arguments are provided, it deploys to all connected devices.
#
# Pass Gradle options after -- :
#   ./deploy -- --info --stacktrace
#   ./deploy tablet -- --debug
#
# To force uninstall first (e.g. to recover from signature mismatch after
# switching build environments or previous release builds):
#   UNINSTALL_FIRST=1 ./deploy
# or
#   ./deploy --clean
#
# To backup DB + test reference images the app reads (vehicle_expenses.db +
# dash reference images (vehicle_ref_*.jpg) + pump pictures + alignment
# experiment photos) + source zips in /sdcard/Download (amazon + pump zips,
# saved as ve_source_zips.tar.gz), force uninstall+install, then restore.
# Does NOT preserve experiment outputs (html/json reports in *_reports dirs).
#   PRESERVE_DATA=1 ./deploy
# or
#   ./deploy --preserve-data
#
# To capture the same backup artifacts as --preserve-data without build,
# uninstall, install, or restore (retrieval only):
#   BACKUP=1 ./deploy
# or
#   ./deploy --backup
#   ./deploy --fetch-data tablet
# (--backup and --fetch-data are identical.)
#
# To restore backed-up data + source zips without building or uninstalling
# (e.g. after you manually wipe the emulator userdata). User is responsible
# for wiping the system image if desired before using --restore-data.
#   RESTORE_DATA=1 ./deploy
# or
#   ./deploy --restore-data
#   ./deploy --restore-data tablet
#
# To install data from any chosen backup dir (standalone; no build, no uninstall).
# Use after a manual fresh install on a new emulator. Lists available backups if
# no dir given. Pushes DB + refs + pump/alignment photos + source zips to all
# devices or specified targets. User picks the backup (not tied to current DEV).
#   INSTALL_DATA=1 ./deploy
# or
#   ./deploy --install-data
#   ./deploy --install-data test-data-backups/<name>
#   ./deploy --install-data test-data-backups/<name> tablet
#
# --restore-data and --install-data now bust Coil image cache (rm cache/*),
# clear Room WAL/shm, touch vehicle_ref_*.jpg mtimes, write files/refdata_version.txt,
# force-stop, and launch MainActivity with --activity-clear-task so ManageVehicles
# shows the correct distinct Honda/Ford dash photos after a push (not stale Coil bitmaps).
# Post-restore verify prints on-device md5 vs vehicle_refs.manifest and DB rows for id 1/2.
#
# To push specific phone-updated reference dash photos without a full backup (Honda/Ford):
#   ./deploy --push-vehicle-refs /path/to/vehicle_ref_1778726321661.jpg /path/to/vehicle_ref_1778726533320.jpg
#   ./deploy --push-vehicle-refs /path/to/dir/with/vehicle_ref_*.jpg tablet
#   ./push-vehicle-refs.sh /path/to/dir tablet
#   PUSH_VEHICLE_REFS_DIR=/path/to/dir ./deploy --push-vehicle-refs emulator
# Expected md5 (phone refs): Honda vehicle_ref_1778726321661.jpg = 89912f28791fbbec046e62aedd9f474c;
# Ford vehicle_ref_1778726533320.jpg = a077932aaa38780e404475cd1012ade8.
# Crop coordinates in DB should be ICRS (raw pixels); legacy 0-1 values may still display if consistent.
#
# When capturing backups, optional VEHICLE_REFS_SOURCE_DIR=/local/dir skips device tar capture
# and packages vehicle_ref_*.jpg from that dir (with vehicle_refs.manifest: size, mtime, md5).
#
# SAFETY: If PRESERVE_DATA is requested but a device has the app installed and
# we fail to capture any backup data (DB or images), we will REFUSE to uninstall.
# This prevents destroying your test data when backup or the subsequent build fails.
#
# Backups saved locally to ./test-data-backups/<device>-<timestamp>/
# Requires debug build + run-as support on the device (typical for emulators).
#
# Note: Force uninstall will remove app data (DB, prefs, etc.) unless using
# PRESERVE_DATA. Normal deploys (matching cert) update in-place without loss.

PACKAGE_NAME="com.davidlang.vehicleexpensesautomated"

deploy_usage() {
  cat <<'EOF'
Usage: ./deploy [options] [device-alias|device-id ...] [-- gradle-flags...]

Build, install, and deploy the debug APK. With no device arguments, all connected
online devices are targeted.

Options:
  -h, --help              Show this help and exit
      --preserve-data     Backup app data, uninstall+reinstall, restore backup
                          (refuses uninstall if backup capture fails)
      --backup, --fetch-data
                          Capture test data from device(s) only (same artifacts as
                          --preserve-data backup step; no build/uninstall/restore)
      --restore-data      Restore latest per-device backup only (no build/uninstall)
      --install-data [DIR]
                          Install data from a chosen backup dir (no build/uninstall).
                          DIR may be test-data-backups/<name> or a short backup name.
                          Lists available backups if DIR is omitted.
      --clean             Force uninstall before install (signature recovery)
      --push-vehicle-refs Push specific vehicle_ref_*.jpg files/dirs only
      --push-test-data [DIR]
                          Stream source zips from a backup dir to device
                          /sdcard/Download via tar pipe (no local tar file).
                          Reads source_zips/*.zip or *.zip in the backup dir.
                          Uses latest backup with zips if DIR is omitted.

Device aliases (see DEVICE_MAP in deploy script):
  tablet, emulator        -> emulator-5554
  Any other argument      -> treated as adb device id (e.g. emulator-5556)

Environment variables (equivalent to flags where noted):
  PRESERVE_DATA=1         Same as --preserve-data
  BACKUP=1, FETCH_DATA=1  Same as --backup / --fetch-data
  RESTORE_DATA=1          Same as --restore-data
  INSTALL_DATA=1          Same as --install-data (set SELECTED_BACKUP=... for DIR)
  UNINSTALL_FIRST=1       Same as --clean
  PUSH_VEHICLE_REFS_DIR   Default source dir for --push-vehicle-refs
  VEHICLE_REFS_SOURCE_DIR Local dir of vehicle_ref_*.jpg when capturing backups

Gradle passthrough:
  ./deploy [options] [devices...] -- --info --stacktrace

Examples:
  ./deploy
  ./deploy tablet
  ./deploy --preserve-data emulator-5556
  ./deploy --backup emulator-5556
  ./deploy --fetch-data tablet
  ./deploy --clean tablet
  ./deploy --restore-data emulator-5556
  ./deploy --install-data test-data-backups/adb-...-20260622-180409 emulator-5556
  ./deploy --install-data adb-...-20260622-180409 emulator-5556
  ./deploy --push-vehicle-refs /path/to/vehicle_ref_1778726321661.jpg tablet
  ./deploy --push-test-data test-data-backups/emulator-5554-source-zips-... emulator-5556

Environment: PUSH_TEST_DATA=1 (optional SELECTED_BACKUP=... for DIR)

Backups live in ./test-data-backups/<device-or-source>-<timestamp>/ and may contain:
  vehicle_expenses.db.bak, vehicle_refs.tar.gz, pump_photos.tar.gz,
  alignment_photos.tar.gz, ve_source_zips.tar.gz

--install-data / --restore-data bust Coil cache, clear Room WAL, and relaunch the app.
Requires debug build + run-as on the target device.
EOF
}

is_backup_arg() {
  local arg=$1
  [ -n "$arg" ] || return 1
  [ -d "$arg" ] || [ -d "test-data-backups/$arg" ] || [[ "$arg" == *test-data-backups* ]] || [[ "$arg" == *-[0-9][0-9][0-9][0-9][0-9][0-9]* ]]
}

resolve_backup_dir() {
  local candidate=$1
  if [ -d "$candidate" ]; then
    printf '%s\n' "$candidate"
  elif [ -d "test-data-backups/$candidate" ]; then
    printf '%s\n' "test-data-backups/$candidate"
  fi
}

list_available_backups() {
  echo "Available backups:"
  ls -td test-data-backups/* 2>/dev/null || echo "(none)"
}

backup_has_source_zips() {
  local dir=$1
  local src
  src=$(resolve_source_zips_dir "$dir") || return 1
  [ -n "$src" ]
}

latest_backup_with_source_zips() {
  local dir
  for dir in $(ls -td test-data-backups/* 2>/dev/null); do
    if backup_has_source_zips "$dir"; then
      printf '%s\n' "$dir"
      return 0
    fi
  done
  return 1
}

# Directory whose *.zip files are streamed to the device (no local tar artifact).
resolve_source_zips_dir() {
  local backup_dir=$1
  shopt -s nullglob
  local nested=("$backup_dir/source_zips"/*.zip)
  local top=("$backup_dir"/*.zip)
  shopt -u nullglob
  if [ ${#nested[@]} -gt 0 ]; then
    printf '%s\n' "$backup_dir/source_zips"
    return 0
  fi
  if [ ${#top[@]} -gt 0 ]; then
    printf '%s\n' "$backup_dir"
    return 0
  fi
  return 1
}

push_source_zips_to_device() {
  local DEV=$1
  local BACKUP_DIR=$2
  local SRC_DIR
  local zip_count
  SRC_DIR=$(resolve_source_zips_dir "$BACKUP_DIR") || {
    echo "  [push-test-data] No *.zip in $BACKUP_DIR/source_zips/ or $BACKUP_DIR"
    return 1
  }
  shopt -s nullglob
  local zips=("$SRC_DIR"/*.zip)
  zip_count=${#zips[@]}
  shopt -u nullglob
  echo "  [push-test-data] Streaming $zip_count zip(s) from $SRC_DIR to $DEV:/sdcard/Download (tar pipe, no local tar file)"
  # Stream gzip tar to device stdin -> extract directly into Download.
  if tar czf - -C "$SRC_DIR" . | adb -s "$DEV" shell 'mkdir -p /sdcard/Download && cd /sdcard/Download && tar xzf -'; then
    :
  else
    echo "  [push-test-data] Direct tar pipe failed; retrying via transient /sdcard/ve_source_zips.tar.gz on device"
    if ! tar czf - -C "$SRC_DIR" . | adb -s "$DEV" shell 'cat > /sdcard/ve_source_zips.tar.gz'; then
      echo "  [push-test-data] Failed to stream tar to $DEV"
      return 1
    fi
    if ! adb -s "$DEV" shell 'mkdir -p /sdcard/Download && cd /sdcard/Download && tar xzf /sdcard/ve_source_zips.tar.gz && rm -f /sdcard/ve_source_zips.tar.gz'; then
      echo "  [push-test-data] Failed to extract streamed tar on $DEV"
      adb -s "$DEV" shell 'rm -f /sdcard/ve_source_zips.tar.gz' 2>/dev/null || true
      return 1
    fi
  fi
  echo "  [push-test-data] Download zips on $DEV:"
  adb -s "$DEV" shell 'ls -la /sdcard/Download/*.zip 2>/dev/null || true' 2>/dev/null || true
}

# Parse options with GNU getopt (long options). Remaining args: optional backup name,
# device targets, optional --, then gradle flags.
TARGETS=()
PUSH_REF_PATHS=()
GRADLE_ARGS=()
PRESERVE_DATA=${PRESERVE_DATA:-false}
UNINSTALL_FIRST=${UNINSTALL_FIRST:-false}
RESTORE_DATA=${RESTORE_DATA:-false}
INSTALL_DATA=${INSTALL_DATA:-false}
PUSH_VEHICLE_REFS=${PUSH_VEHICLE_REFS:-false}
PUSH_TEST_DATA=${PUSH_TEST_DATA:-false}
BACKUP_ONLY=${BACKUP_ONLY:-false}
SELECTED_BACKUP=${SELECTED_BACKUP:-}

if ! PARSED=$(getopt -o h -l help,preserve-data,backup,fetch-data,restore-data,install-data,clean,push-vehicle-refs,push-test-data -- "$@"); then
  deploy_usage
  exit 1
fi
eval set -- "$PARSED"
while true; do
  case "$1" in
    -h|--help)
      deploy_usage
      exit 0
      ;;
    --preserve-data)
      PRESERVE_DATA=true
      shift
      ;;
    --backup|--fetch-data)
      BACKUP_ONLY=true
      shift
      ;;
    --restore-data)
      RESTORE_DATA=true
      shift
      ;;
    --install-data)
      INSTALL_DATA=true
      shift
      ;;
    --clean)
      UNINSTALL_FIRST=true
      shift
      ;;
    --push-vehicle-refs)
      PUSH_VEHICLE_REFS=true
      shift
      ;;
    --push-test-data)
      PUSH_TEST_DATA=true
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if { [ "$INSTALL_DATA" = "true" ] || [ "$PUSH_TEST_DATA" = "true" ]; } && [ $# -gt 0 ] && is_backup_arg "$1"; then
  SELECTED_BACKUP="$1"
  shift
fi

SEEN_DD=false
for arg in "$@"; do
  if $SEEN_DD; then
    GRADLE_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    SEEN_DD=true
  elif [ "$PUSH_VEHICLE_REFS" = "true" ] && { [ -f "$arg" ] || [ -d "$arg" ]; }; then
    PUSH_REF_PATHS+=("$arg")
  else
    TARGETS+=("$arg")
  fi
done
if [ ${#GRADLE_ARGS[@]} -gt 0 ]; then
  echo "Passing Gradle flags: ${GRADLE_ARGS[*]}"
fi

# Normalize env-var truthiness (1/true/yes).
truthy() {
  case "${1,,}" in 1|true|yes) return 0 ;; esac
  return 1
}
if truthy "${PRESERVE_DATA}"; then PRESERVE_DATA=true; fi
if truthy "${UNINSTALL_FIRST}"; then UNINSTALL_FIRST=true; fi
if truthy "${RESTORE_DATA}"; then RESTORE_DATA=true; fi
if truthy "${INSTALL_DATA}"; then INSTALL_DATA=true; fi
if truthy "${PUSH_VEHICLE_REFS}"; then PUSH_VEHICLE_REFS=true; fi
if truthy "${PUSH_TEST_DATA}"; then PUSH_TEST_DATA=true; fi
if truthy "${BACKUP}"; then BACKUP_ONLY=true; fi
if truthy "${FETCH_DATA}"; then BACKUP_ONLY=true; fi

# Export so values survive the primary/ai-code re-execs that happen later.
export PRESERVE_DATA
export UNINSTALL_FIRST
export RESTORE_DATA
export INSTALL_DATA
export PUSH_VEHICLE_REFS
export PUSH_TEST_DATA
export BACKUP_ONLY
export SELECTED_BACKUP

# Data-only modes never build; skip primary-user / group re-exec (avoids run-as-primary loops).
DATA_ONLY_MODE=false
if [ "$PUSH_TEST_DATA" = "true" ] || [ "$RESTORE_DATA" = "true" ] || \
   [ "$INSTALL_DATA" = "true" ] || [ "$PUSH_VEHICLE_REFS" = "true" ] || \
   [ "$BACKUP_ONLY" = "true" ]; then
  DATA_ONLY_MODE=true
fi

# Ensure backups dir exists (for PRESERVE_DATA)
mkdir -p test-data-backups 2>/dev/null || true

# Load primary_user from project.config for portable primary developer identity (no hardcoded names).
PRIMARY_USER=$(sed -n 's/^primary_user=//p' project.config 2>/dev/null | tr -d '\r' | head -1)
PRIMARY_USER=${PRIMARY_USER:-dlang}
CODER_USER=$(sed -n 's/^coder_user=//p' project.config 2>/dev/null | tr -d '\r' | head -1)
CODER_USER=${CODER_USER:-ai-coder}
CODE_GROUP=$(sed -n 's/^code_group=//p' project.config 2>/dev/null | tr -d '\r' | head -1)
CODE_GROUP=${CODE_GROUP:-ai-code}

# Re-exec as PRIMARY_USER (not root) if we started as root. This ensures we use
# the primary developer's debug keystore (~/.android/debug.keystore) for consistent APK
# signatures across builds/deploys. Running as root uses /root's keystore,
# which produces a different certificate and triggers
# INSTALL_FAILED_UPDATE_INCOMPATIBLE.
if [ "$DATA_ONLY_MODE" = "true" ]; then
  :
elif [ "$EUID" -eq 0 ]; then
  echo "Re-executing as $PRIMARY_USER (not root) for consistent signing keystore..."
  if [ -x ./run-as-primary ]; then
    exec ./run-as-primary "$0" "$@"
  else
    exec sudo -E -u "$PRIMARY_USER" "$0" "$@"
  fi
fi

# Re-exec as PRIMARY_USER if not already running as them. This ensures all build/deploy
# artifacts are consistently owned by the primary developer (dlang), preventing ownership
# drift to ai-orchestrator/root and the resulting permission thrashing on cxx/logs/etc.
CURRENT_USER=$(id -un)
if [ "$DATA_ONLY_MODE" != "true" ] && [ "$CURRENT_USER" != "$PRIMARY_USER" ]; then
  echo "Re-executing as $PRIMARY_USER for consistent ownership of build artifacts..."
  if [ -x ./run-as-primary ]; then
    exec ./run-as-primary "$0" "$@"
  else
    exec sudo -E -u "$PRIMARY_USER" "$0" "$@"
  fi
fi

# Ensure group-writable creation for build artifacts and Gradle caches (664/2775 sources)
umask 002

# Both ai-shared and ai-code are required. Agent builds leave app/build and project
# .gradle as ai-coder:ai-code 66x — without ai-code in *this process*, dlang cannot
# write fileHashes.lock (EACCES). Do NOT use `sg ai-shared` alone: that only fixes
# one primary GID and historically re-ran deploy still missing ai-code.
if [ "$DATA_ONLY_MODE" != "true" ]; then
  MISSING=""
  for grp in ai-shared ai-code; do
    if ! id -nG | grep -qw "$grp"; then MISSING="$MISSING $grp"; fi
  done
  if [ -n "$MISSING" ]; then
    echo "ERROR: this shell is missing project group(s):$MISSING" >&2
    echo "  Agent/build caches are group ai-code; git/sandbox need ai-shared." >&2
    echo "  Fix (no full logout):  source ./ve-env" >&2
    echo "  Or open a shell from setup_agent (execs ve-refresh-shell)." >&2
    echo "  Then re-run:  ./deploy" >&2
    echo "  Do NOT:  sg ai-shared  (single-group; breaks multi-user deploy)" >&2
    exit 1
  fi
fi

# Use project-local shared Gradle home (not per-user ~/.gradle).
# Required for multi-user builds: same users serve different projects.
ORCH_ROOT="$(cd "$(dirname "$0")" && pwd)"
# For worktrees, the orchestration root is the parent
[ -d "$ORCH_ROOT/../.gradle-shared" ] && ORCH_ROOT="$(cd "$ORCH_ROOT/.." && pwd)"
if [ -d "$ORCH_ROOT/.gradle-shared" ]; then
  export GRADLE_USER_HOME="$ORCH_ROOT/.gradle-shared"
  export GRADLE_OPTS="-Dorg.gradle.daemon.registry.base=/home/\$(id -un)/.gradle/daemon"
fi
# Shared Android home: consistent debug keystore for all builders
if [ -d "$ORCH_ROOT/.android-shared" ]; then
  export ANDROID_USER_HOME="$ORCH_ROOT/.android-shared"
fi

# Early recovery for build dir perms/ownership (prevents "Permission denied" on cxx logs,
# configuration cache stale outputs, etc. from previous root/wrong-group runs).
# This runs whenever you use ./deploy (which does the group re-exec).
fix_build_dir_perms() {
  if [ -d app/build ]; then
    echo "  Fixing build dir perms (traversable + group writable)..."
    # chmod parents first so we can traverse and fix deep cxx etc.
    chmod -R u+rX,g+rX app/build 2>/dev/null || true
    chmod -R u+rwX,g+rwX app/build 2>/dev/null || true
    # setgid on dirs for proper inheritance on new files (with umask 007 -> 660/770)
    find app/build -type d -exec chmod 2770 {} + 2>/dev/null || true
    find app/build -type f -exec chmod 660 {} + 2>/dev/null || true
  fi
}
fix_build_dir_perms

# Multi-user handoff: agent (ai-coder) builds leave app/build and project .gradle
# owned by ai-coder:ai-code. chmod of foreign files often fails for non-owners;
# setgid dirs (2770/2775) allow group members to unlink — wipe caches instead.
# Policy: no Gradle daemon; clear KSP + project .gradle locks/hashes that cause
# "fileHashes.lock (Permission denied)" when a prior user left the tree.
# 2755 (umask 022) dirs owned by another user cannot be wiped by group members;
# fail-fast rather than letting :app:kspDebugKotlin fail mid-build.
prepare_build_tree_for_deploy() {
  echo "  Preparing build tree for deploy (wipe KSP/incremental/.gradle locks; multi-user safe)..."
  if [ -d app/build ]; then
    chmod -R u+rX,g+rX app/build 2>/dev/null || true
    chmod -R u+rwX,g+rwX app/build 2>/dev/null || true
  fi
  rm -rf app/build/kspCaches app/build/intermediates app/build/generated 2>/dev/null || true

  # Project-local .gradle (NOT GRADLE_USER_HOME): fileHashes.lock etc. after ai-coder builds
  if [ -d .gradle ]; then
    chmod -R u+rX,g+rX .gradle 2>/dev/null || true
    chmod -R u+rwX,g+rwX .gradle 2>/dev/null || true
    # Drop locks/version caches so this user can recreate them
    find .gradle -name '*.lock' -delete 2>/dev/null || true
    rm -rf .gradle/configuration-cache* 2>/dev/null || true
    # If still not writable (missing group / sticky mess), wipe whole project .gradle
    if ! touch .gradle/.ve_write_test 2>/dev/null; then
      echo "  Project .gradle not writable by $(id -un) — removing for clean rebuild..."
      rm -rf .gradle 2>/dev/null || true
    else
      rm -f .gradle/.ve_write_test
      # Versioned fileHashes often still open/create as non-owner; drop 9.x caches if present
      rm -rf .gradle/[0-9]* 2>/dev/null || true
    fi
  fi

  # Residual KSP/incremental trees (2755 foreign-owned) block dlang deploy.
  local residual=""
  for d in app/build/kspCaches app/build/intermediates app/build/generated; do
    if [ -e "$d" ]; then
      residual="$residual $d"
    fi
  done
  if [ -n "$residual" ]; then
    echo "  Wipe incomplete (foreign 2755/non-group-writable dirs common):$residual"
    echo "  Trying sudo -n -u ${CODER_USER} rm -rf on residual paths..."
    # shellcheck disable=SC2086
    if sudo -n -u "$CODER_USER" rm -rf $residual 2>/dev/null; then
      residual=""
      for d in app/build/kspCaches app/build/intermediates app/build/generated; do
        if [ -e "$d" ]; then residual="$residual $d"; fi
      done
    fi
  fi
  if [ -n "$residual" ]; then
    echo "ERROR: Cannot remove multi-user build caches (Gradle would fail at kspDebugKotlin)." >&2
    echo "  Residual:$residual" >&2
    echo "  Sample modes:" >&2
    # shellcheck disable=SC2086
    ls -ld $residual 2>/dev/null | head -10 >&2 || true
    local sample
    sample=$(find app/build/generated app/build/kspCaches app/build/intermediates -type d ! -perm -g+w 2>/dev/null | head -5)
    if [ -n "$sample" ]; then
      echo "  Non-group-writable dirs (need owner wipe or chown):" >&2
      echo "$sample" | while read -r p; do ls -ld "$p" 2>/dev/null; done >&2
    fi
    echo "  Fix (pick one), then re-run ./deploy:" >&2
    echo "    sudo -u ${CODER_USER} rm -rf app/build/generated app/build/kspCaches app/build/intermediates" >&2
    echo "    sudo chown -R ${PRIMARY_USER}:${CODE_GROUP} app/build && find app/build -type d -exec chmod 2770 {} +" >&2
    echo "  Ensure: id shows ${CODE_GROUP} (source ./ve-env)." >&2
    return 1
  fi
  return 0
}
if [ "$DATA_ONLY_MODE" != "true" ]; then
  if ! prepare_build_tree_for_deploy; then
    echo "Aborting deploy: build tree not handoff-safe." >&2
    exit 1
  fi
fi

repair_shared_cache() {
  # Post-build permission repair for all shared build directories
  for gdir in "${GRADLE_USER_HOME:-}" .gradle app/build; do
    if [ -d "$gdir" ]; then
      echo "  Quick $gdir permission repair (group sync + setgid + ug+rwX)..."
      local grp="ai-code"
      if [[ "$gdir" == *".gradle-shared"* || "$gdir" == *".android-shared"* ]]; then
        grp="ai-shared"
      fi
      chgrp -R "$grp" "$gdir" 2>/dev/null || true
      find "$gdir" -type d -exec chmod 2770 {} + 2>/dev/null || true
      chmod -R ug+rwX,o-rwx "$gdir" 2>/dev/null || true
    fi
  done
}

# Best-effort fix for .git / worktree git state early (before any gradle exec that
# computes versionName). Broken zero-SHA refs or wrong ownership (ai-orchestrator)
# are common after permission thrashing.
fix_git_perms() {
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local main_git
    main_git=$(git rev-parse --git-common-dir 2>/dev/null || echo .git)
    echo "  Fixing .git/worktree perms (best effort, sudo ../fix-perms may still be needed for objects)..."
    chmod -R u+rX,g+rX "$main_git" 2>/dev/null || true
    chmod -R u+rwX,g+rwX "$main_git" 2>/dev/null || true
    # Repair worktree metadata too
    if [ -f .git ]; then
      local wt_meta
      wt_meta=$(sed 's/gitdir: //' .git)
      if [ -d "$wt_meta" ]; then
        chmod -R u+rX,g+rX "$wt_meta" 2>/dev/null || true
        chmod -R u+rwX,g+rwX "$wt_meta" 2>/dev/null || true
      fi
    fi
    # If the current branch ref is the all-zero broken state, remove the loose ref
    # so git falls back to packed-refs (which usually has a good value).
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [ -n "$branch" ] && [ "$branch" != "HEAD" ]; then
      local ref="$main_git/refs/heads/$branch"
      if [ -f "$ref" ] && grep -q '^0\{40\}' "$ref" 2>/dev/null; then
        echo "  Removing broken zero-SHA ref for $branch (will use packed-refs)..."
        rm -f "$ref" 2>/dev/null || true
      fi
    fi
  fi
}
fix_git_perms

stop_gradle_daemons() {
  echo "  Stopping Gradle daemons robustly..."
  ./gradlew --stop >/dev/null 2>&1 || true

  # Force-kill any BUSY or lingering daemons for the current Gradle version.
  # --stop sometimes leaves BUSY ones or STOPPED that don't exit due to open files/locks/perm issues.
  # We parse --status (which only shows current version) and kill the PIDs if they still exist.
  while read -r pid status rest; do
    case "$status" in
      BUSY|STOPPED)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
          echo "    Killing lingering Gradle daemon PID $pid ($status)..."
          kill -TERM "$pid" 2>/dev/null || true
          sleep 0.5
          kill -9 "$pid" 2>/dev/null || true
        fi
        ;;
    esac
  done < <(./gradlew --status 2>/dev/null | awk 'NR>1 && $1 ~ /^[0-9]+$/ {print $1, $2}')

  # Also kill any GradleDaemon processes that might be holding this project's build (defensive)
  pkill -f "GradleDaemon.*$(pwd | sed 's/[][\.*^$()+?{}|]/\\&/g')" 2>/dev/null || true
  sleep 1
}
# Policy: no Gradle daemon (build_app and deploy pass --no-daemon). stop_gradle_daemons
# remains for recovery if a leftover daemon from old runs still holds files open.

